---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const solutionItems = [
  { href: '/zero-trabalho-sindico', label: 'Zero trabalho para o síndico' },
  { href: '/seguranca-do-mercado', label: 'Segurança' },
  { href: '/vantagens-para-moradores', label: 'Para moradores' },
  { href: '/como-funciona-na-pratica', label: 'Na prática' },
  { href: '/diagnostico-condominio', label: 'Diagnóstico gratuito' },
];

const navItems = [
  { href: '/como-funciona', label: 'Como funciona' },
  { href: '/quanto-custa', label: 'Quanto custa' },
  { href: '/faq', label: 'Dúvidas' },
  { href: '/sobre', label: 'Sobre' },
];

const mobileItems = [
  { href: '/', label: 'Início' },
  ...navItems.slice(0, 2),
  ...solutionItems.slice(0, 3),
  { href: '/diagnostico-condominio', label: 'Diagnóstico' },
  ...navItems.slice(2),
];

const isActive = (href: string) => currentPath === href;
const solutionsActive = solutionItems.some((i) => isActive(i.href));
---

<header id="header" class="header">
  <div class="container">
    <nav class="nav" aria-label="Navegação principal">
      <a href="/" class="logo" aria-label="Just Go Market — página inicial">
        <img src="/assets/images/logo-negativo.png" alt="Just Go Market" width="640" height="92" />
      </a>

      <div class="nav-links">
        <a href={navItems[0].href} class:list={['nav-link', { 'active-link': isActive(navItems[0].href) }]}>{navItems[0].label}</a>

        <div class="nav-item-dropdown">
          <button type="button" class:list={['nav-link', 'dropdown-trigger', { 'active-link': solutionsActive }]} aria-haspopup="true">
            Soluções
            <svg class="chevron-icon" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <ul class="dropdown-menu">
            {solutionItems.map((item) => (
              <li><a href={item.href} class="dropdown-link">{item.label}</a></li>
            ))}
          </ul>
        </div>

        {navItems.slice(1).map((item) => (
          <a href={item.href} class:list={['nav-link', { 'active-link': isActive(item.href) }]}>{item.label}</a>
        ))}
      </div>

      <div style="display: flex; align-items: center; gap: 12px;">
        <a href="/#contato" class="btn btn-primary desktop-only">Solicitar projeto</a>
        <button class="mobile-menu-btn" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>
      </div>
    </nav>
  </div>
</header>

<div class="mobile-menu-overlay" id="mobile-menu">
  <div class="mobile-menu-content">
    <nav class="mobile-nav" aria-label="Menu mobile">
      {mobileItems.map((item) => (
        <a href={item.href} class:list={['mobile-link', { 'active-link': isActive(item.href) }]}>{item.label}</a>
      ))}
    </nav>
    <div class="mobile-cta">
      <a href="/#contato" class="btn btn-primary btn-block">Solicitar projeto gratuito <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </div>
</div>

<script>
  // Header: vidro ao rolar; some ao descer e volta ao subir
  const header = document.getElementById('header');
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      header.classList.toggle('scrolled', y > 40);
      const menuOpen = document.querySelector('.mobile-menu-overlay.active');
      header.classList.toggle('is-hidden', !menuOpen && y > 400 && y > lastY + 4);
      if (y < lastY - 4 || y < 400) header.classList.remove('is-hidden');
      lastY = y;
      ticking = false;
    };
    update();
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
  }

  // Menu mobile
  const mobileBtn = document.querySelector<HTMLButtonElement>('.mobile-menu-btn');
  const mobileMenu = document.querySelector('.mobile-menu-overlay');

  if (mobileBtn && mobileMenu) {
    const setOpen = (open: boolean) => {
      mobileBtn.classList.toggle('active', open);
      mobileMenu.classList.toggle('active', open);
      mobileBtn.setAttribute('aria-expanded', String(open));
      mobileBtn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
      document.body.style.overflow = open ? 'hidden' : '';
    };

    mobileBtn.addEventListener('click', () => setOpen(!mobileMenu.classList.contains('active')));
    mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>

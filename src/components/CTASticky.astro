---
// CTA Sticky bar — appears on scroll
---

<div class="cta-sticky" id="cta-sticky">
  <p>Instalação <strong>custo zero</strong> para o seu condomínio</p>
  <a href="/#contato" class="btn btn-primary" id="cta-sticky-btn" style="padding: 0 22px; min-height: 44px; font-size: 0.875rem; flex-shrink: 0;">
    Solicitar projeto
  </a>
</div>

<script>
  const ctaSticky = document.getElementById('cta-sticky');
  if (ctaSticky) {
    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      if (scrollY > 600 && scrollY > lastScroll) {
        ctaSticky.classList.add('visible');
      } else if (scrollY < 300) {
        ctaSticky.classList.remove('visible');
      }
      // Esconde perto do formulário/rodapé para não competir com o CTA principal
      const contato = document.getElementById('contato');
      if (contato && contato.getBoundingClientRect().top < window.innerHeight) {
        ctaSticky.classList.remove('visible');
      }
      document.body.classList.toggle('cta-visible', ctaSticky.classList.contains('visible'));
      lastScroll = scrollY;
    }, { passive: true });
  }

  const ctaStickyBtn = document.getElementById('cta-sticky-btn');
  if (ctaStickyBtn) {
    ctaStickyBtn.addEventListener('click', () => {
      if (window.dataLayer) {
        window.dataLayer.push({ event: 'cta_click', click_location: 'sticky_bar' });
      }
    });
  }
</script>

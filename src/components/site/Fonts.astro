---
/**
 * Fontes self-hosted (sem Google Fonts em runtime).
 * Alexandria → títulos · Wix Madefor Display → chamadas · Wix Madefor Text → corpo.
 * Apenas os subconjuntos latin e latin-ext; o navegador baixa só o que a página usa.
 * Os fallbacks com métricas ajustadas evitam deslocamento de layout na troca (CLS).
 */
import alexLatin from '@fontsource-variable/alexandria/files/alexandria-latin-wght-normal.woff2?url';
import alexLatinExt from '@fontsource-variable/alexandria/files/alexandria-latin-ext-wght-normal.woff2?url';
import textLatin from '@fontsource-variable/wix-madefor-text/files/wix-madefor-text-latin-wght-normal.woff2?url';
import textLatinExt from '@fontsource-variable/wix-madefor-text/files/wix-madefor-text-latin-ext-wght-normal.woff2?url';
import displayLatin from '@fontsource-variable/wix-madefor-display/files/wix-madefor-display-latin-wght-normal.woff2?url';
import displayLatinExt from '@fontsource-variable/wix-madefor-display/files/wix-madefor-display-latin-ext-wght-normal.woff2?url';

const latin =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
const latinExt =
  'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF';

const face = (family: string, src: string, range: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:400 800;src:url(${src}) format('woff2-variations'),url(${src}) format('woff2');unicode-range:${range};}`;

const css = [
  face('Alexandria', alexLatin, latin),
  face('Alexandria', alexLatinExt, latinExt),
  face('Wix Madefor Text', textLatin, latin),
  face('Wix Madefor Text', textLatinExt, latinExt),
  face('Wix Madefor Display', displayLatin, latin),
  face('Wix Madefor Display', displayLatinExt, latinExt),
  "@font-face{font-family:'Alexandria Fallback';src:local('Arial');size-adjust:113%;ascent-override:85.7%;descent-override:22.2%;line-gap-override:0%;}",
  "@font-face{font-family:'Wix Madefor Fallback';src:local('Arial');size-adjust:104.8%;ascent-override:96.2%;descent-override:24%;line-gap-override:0%;}",
].join('');
---

<link rel="preload" href={alexLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={textLatin} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css}></style>

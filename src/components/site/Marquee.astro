---
/**
 * Faixa de marcas em movimento horizontal (marquee).
 * CSS puro (translateX), pausa ao passar o mouse ou focar, máscara suave nas bordas.
 * Só nomes, em tipografia da Just Go — nunca logotipos de terceiros.
 *
 * size  → 'md' (faixa discreta) ou 'lg' (destaque editorial)
 * rows  → 1 ou 2 (a segunda linha corre no sentido oposto)
 * Com "reduzir movimento" ou na impressão, a faixa para e as marcas aparecem em linha.
 * Marcas de referência: src/lib/brands.ts (PREMIUM_BRANDS).
 */
interface Props {
  brands: string[];
  size?: 'md' | 'lg';
  rows?: 1 | 2;
  label?: string;
  class?: string;
}

const { brands, size = 'md', rows = 1, label = 'Marcas de referência da curadoria', class: className = '' } = Astro.props;
const half = Math.ceil(brands.length / 2);
const lines = rows === 2 ? [brands.slice(0, half), brands.slice(half)] : [brands];
---

<div class:list={['mq', `mq-${size}`, className]} role="region" aria-label={label}>
  {
    lines.map((line, r) => (
      <div class:list={['mq-row', r === 1 && 'mq-reverse']}>
        <ul class="mq-track" style={`--dur:${Math.max(36, line.length * 4)}s`}>
          {line.map((b) => (
            <li>{b}</li>
          ))}
          {line.map((b) => (
            <li aria-hidden="true">{b}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  @layer components {
    .mq {
      --gap: clamp(28px, 4vw, 64px);
      display: grid;
      gap: clamp(8px, 1.6vw, 20px);
      overflow: hidden;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    }

    .mq-md {
      margin-top: 72px;
    }

    .mq-row {
      overflow: hidden;
    }

    .mq-track {
      display: flex;
      align-items: center;
      gap: var(--gap);
      width: max-content;
      animation: mq var(--dur, 48s) linear infinite;
    }

    .mq-reverse .mq-track {
      animation-direction: reverse;
    }

    .mq:hover .mq-track,
    .mq:focus-within .mq-track {
      animation-play-state: paused;
    }

    .mq-track li {
      display: inline-flex;
      align-items: center;
      gap: var(--gap);
      white-space: nowrap;
      font-family: var(--font-display);
      font-size: 1.125rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--fg-3);
    }

    /* Separador discreto: ponto verde da marca */
    .mq-track li::after {
      content: '';
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--jg-green);
      opacity: 0.7;
    }

    .theme-light .mq-track li::after,
    .theme-paper .mq-track li::after {
      background: var(--fg-3);
    }

    /* Destaque editorial: nomes grandes, em caixa normal, alternando peso visual */
    .mq-lg .mq-track li {
      font-family: var(--font-title);
      font-size: clamp(1.75rem, 4.2vw, 3.6rem);
      font-weight: 500;
      letter-spacing: -0.035em;
      text-transform: none;
      color: var(--fg);
      line-height: 1.15;
    }

    .mq-lg .mq-reverse .mq-track li {
      color: var(--fg-3);
    }

    @keyframes mq {
      to {
        transform: translateX(calc(-50% - var(--gap) / 2));
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .mq-track {
        animation: none;
        flex-wrap: wrap;
        width: auto;
        row-gap: 8px;
      }

      .mq-track li[aria-hidden] {
        display: none;
      }
    }

    @media print {
      .mq {
        -webkit-mask-image: none;
        mask-image: none;
      }

      .mq-track {
        animation: none;
        flex-wrap: wrap;
        width: auto;
        row-gap: 4px;
      }

      .mq-track li[aria-hidden] {
        display: none;
      }
    }
  }
</style>

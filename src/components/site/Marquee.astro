---
/**
 * Faixa de marcas em movimento horizontal (marquee).
 * CSS puro (translateX), pausa ao passar o mouse ou focar, máscara suave nas bordas.
 * Só nomes, em tipografia da Just Go — nunca logotipos de terceiros.
 *
 * size  → 'md' ou 'lg' (mesmo conceito, corpo maior)
 * rows  → 1 (padrão) ou 2 (mesmo sentido e velocidade, para listas longas)
 * Com "reduzir movimento" ou na impressão, a faixa para e as marcas aparecem em linha.
 * Marcas de referência: src/lib/brands.ts (PREMIUM_BRANDS).
 */
interface Props {
  brands: string[];
  size?: 'md' | 'lg';
  rows?: 1 | 2;
  label?: string;
  class?: string;
}

const { brands, size = 'md', rows = 1, label = 'Marcas de referência da curadoria', class: className = '' } = Astro.props;
const half = Math.ceil(brands.length / 2);
const lines = rows === 2 ? [brands.slice(0, half), brands.slice(half)] : [brands];
---

<div class:list={['mq', `mq-${size}`, className]} role="region" aria-label={label}>
  {
    lines.map((line, r) => (
      <div class="mq-row" data-row={r}>
        <ul class="mq-track" style={`--dur:${Math.max(48, line.length * 2.4)}s`}>
          {line.map((b) => (
            <li>{b}</li>
          ))}
          {line.map((b) => (
            <li aria-hidden="true">{b}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  @layer components {
    /*
     * Conceito: uma linha só, ritmo constante. Todas as marcas no mesmo corpo,
     * caixa alta espaçada, peso leve e baixa opacidade — a faixa "respira" atrás do
     * conteúdo; a marca sob o cursor ganha opacidade total.
     */
    .mq {
      --gap: clamp(40px, 5vw, 88px);
      --ink: color-mix(in srgb, var(--fg) 48%, transparent); /* ≈4,6:1 sobre o preto (WCAG AA) */
      display: grid;
      gap: clamp(10px, 1.4vw, 18px);
      overflow: hidden;
      padding-block: clamp(18px, 2.4vw, 32px);
      border-block: 1px solid var(--line);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    }

    .mq-md {
      margin-top: 72px;
    }

    .mq-row {
      overflow: hidden;
    }

    .mq-track {
      display: flex;
      align-items: center;
      gap: var(--gap);
      width: max-content;
      animation: mq var(--dur, 60s) linear infinite;
    }

    .mq:hover .mq-track,
    .mq:focus-within .mq-track {
      animation-play-state: paused;
    }

    .mq-track li {
      white-space: nowrap;
      font-family: var(--font-display);
      font-size: 0.9375rem;
      font-weight: 400;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      line-height: 1;
      color: var(--ink);
      transition: color var(--dur-s) var(--ease-soft);
    }

    .mq-track li:hover {
      color: var(--fg);
    }

    .mq-lg .mq-track li {
      font-size: clamp(1rem, 1.5vw, 1.375rem);
      letter-spacing: 0.24em;
    }

    @keyframes mq {
      to {
        transform: translateX(calc(-50% - var(--gap) / 2));
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .mq-track {
        animation: none;
        flex-wrap: wrap;
        width: auto;
        row-gap: 14px;
      }

      .mq-track li[aria-hidden] {
        display: none;
      }
    }

    @media print {
      .mq {
        -webkit-mask-image: none;
        mask-image: none;
      }

      .mq-track {
        animation: none;
        flex-wrap: wrap;
        width: auto;
        row-gap: 8px;
      }

      .mq-track li {
        color: var(--fg-2);
      }

      .mq-track li[aria-hidden] {
        display: none;
      }
    }
  }
</style>

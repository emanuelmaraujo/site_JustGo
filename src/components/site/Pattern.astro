---
/**
 * Pattern da marca: repetição do símbolo em grade, em baixa opacidade (3–6%),
 * como textura de fundo em seções escuras ou verdes.
 * drift → deslocamento lentíssimo (translate, nunca rotação).
 */
import { SYMBOL_PATH, SYMBOL_STROKE, SYMBOL_VIEWBOX } from '@lib/brand';

interface Props {
  opacity?: number;
  color?: string;
  size?: number;
  drift?: boolean;
  id: string;
}

const { opacity = 0.04, color = 'var(--jg-offwhite)', size = 132, drift = true, id } = Astro.props;
const symbol = size * 0.36;
const offset = (size - symbol) / 2;
---

<div class:list={['pattern', drift && 'pattern-drift']} style={`--o:${opacity};--tile:${size}px`} aria-hidden="true">
  <svg width="100%" height="100%">
    <defs>
      <pattern id={id} width={size} height={size} patternUnits="userSpaceOnUse">
        <svg x={offset} y={offset} width={symbol} height={symbol} viewBox={SYMBOL_VIEWBOX}>
          <path
            d={SYMBOL_PATH}
            fill="none"
            stroke={color}
            stroke-width={SYMBOL_STROKE}
            stroke-linejoin="round"></path>
        </svg>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
  </svg>
</div>

<style>
  @layer components {
    .pattern {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      opacity: var(--o);
      z-index: 0;
    }

    .pattern svg {
      position: absolute;
      inset: calc(var(--tile) * -1) 0 0 calc(var(--tile) * -1);
      width: calc(100% + var(--tile));
      height: calc(100% + var(--tile));
    }

    :global(.motion) .pattern-drift svg {
      animation: pattern-drift 48s linear infinite;
    }

    @keyframes pattern-drift {
      to {
        transform: translate3d(var(--tile), var(--tile), 0);
      }
    }
  }
</style>

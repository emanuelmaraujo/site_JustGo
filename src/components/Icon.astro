  camera: '<path d="M3 7h3l2-3h8l2 3h3v13H3V7z"/><circle cx="12" cy="13" r="4"/>',
  phone: '<rect x="7" y="2" width="10" height="20" rx="2.5"/><path d="M11 18h2"/>',

---
/**
 * Ícones de traço fino (1.5px, cantos arredondados), derivados da geometria
 * do símbolo. Herdam a cor do texto (currentColor).
 * draw = true → o traço se desenha quando entra na tela (draw-stroke).
 */
interface Props {
  name: IconName;
  size?: number;
  class?: string;
  draw?: boolean;
  label?: string;
}

const icons = {
  'arrow-up-right': '<path d="M7 17L17 7"/><path d="M8 7h9v9"/>',
  'arrow-right': '<path d="M4 12h16"/><path d="M14 6l6 6-6 6"/>',
  'arrow-left': '<path d="M20 12H4"/><path d="M10 6l-6 6 6 6"/>',
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
  menu: '<path d="M4 9h16"/><path d="M4 15h16"/>',
  close: '<path d="M6 6l12 12"/><path d="M18 6L6 18"/>',
  whatsapp:
    '<path d="M4.5 19.5l1.2-3.9A8 8 0 1 1 8.6 18.4L4.5 19.5z"/><path d="M9.3 8.6c.2-.5.6-.6 1-.5l.7 1.7-.6.8c.5 1 1.3 1.8 2.3 2.3l.8-.6 1.7.7c.1.4 0 .8-.5 1-.6.4-1.5.4-2.4 0a7 7 0 0 1-3-3c-.4-.9-.4-1.8 0-2.4z"/>',
  wine: '<path d="M8 3h8l-.4 5.5a3.6 3.6 0 0 1-7.2 0L8 3z"/><path d="M12 12.2V20"/><path d="M8.5 20h7"/>',
  cheese: '<path d="M3 16l9-9 9 4v6H3z"/><path d="M3 16v3h18v-2"/><circle cx="10" cy="14" r="1.2"/><circle cx="16" cy="14.5" r="1"/>',
  basket: '<path d="M4 9h16l-1.6 9.2a2 2 0 0 1-2 1.8H7.6a2 2 0 0 1-2-1.8L4 9z"/><path d="M8.5 9l2-5"/><path d="M15.5 9l-2-5"/>',
  leaf: '<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19l7-7"/>',
  door: '<path d="M6 21V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17"/><path d="M3 21h18"/><path d="M14.5 12h.01"/>',
  scan: '<path d="M4 8V5a1 1 0 0 1 1-1h3"/><path d="M16 4h3a1 1 0 0 1 1 1v3"/><path d="M20 16v3a1 1 0 0 1-1 1h-3"/><path d="M8 20H5a1 1 0 0 1-1-1v-3"/><path d="M8 9v6"/><path d="M11 9v6"/><path d="M14 9v6"/><path d="M17 9v6"/>',
  pay: '<rect x="3" y="6" width="18" height="12" rx="3"/><path d="M3 10h18"/><path d="M7 14.5h3"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="M8 12.3l2.7 2.7L16 9.7"/>',
  camera: '<path d="M3 8a2 2 0 0 1 2-2h2l1.5-2h7L17 6h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8z"/><circle cx="12" cy="12.5" r="3.5"/>',
  key: '<circle cx="8" cy="15" r="4"/><path d="M11 12l8-8"/><path d="M16 7l2 2"/><path d="M14 9l1.5 1.5"/>',
  lock: '<rect x="4.5" y="10" width="15" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 14.5v2"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/>',
  chat: '<path d="M5 18.5V7a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H8.5L5 18.5z"/><path d="M9 9.5h6"/><path d="M9 12.5h4"/>',
  box: '<path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/>',
  wrench: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.2L3 17.8V21h3.2l6.3-6.3a4 4 0 0 0 5.2-5.4l-2.6 2.6-2.4-.6-.6-2.4 2.6-2.6z"/>',
  sparkle: '<path d="M12 3v4"/><path d="M12 17v4"/><path d="M3 12h4"/><path d="M17 12h4"/><path d="M12 8.5a3.5 3.5 0 0 0 3.5 3.5A3.5 3.5 0 0 0 12 15.5 3.5 3.5 0 0 0 8.5 12 3.5 3.5 0 0 0 12 8.5z"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/>',
  ruler: '<rect x="3" y="8" width="18" height="8" rx="2"/><path d="M7 8v3"/><path d="M11 8v4"/><path d="M15 8v3"/><path d="M19 8v4"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="3"/><path d="M3.5 10h17"/><path d="M8 3v4"/><path d="M16 3v4"/>',
  doc: '<path d="M7 3h7l5 5v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M14 3v5h5"/><path d="M9 13h6"/><path d="M9 17h4"/>',
  building: '<path d="M5 21V5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v16"/><path d="M16 10h2a2 2 0 0 1 2 2v9"/><path d="M3 21h18"/><path d="M9 7h3"/><path d="M9 11h3"/><path d="M9 15h3"/>',
  users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7"/><path d="M21.5 20a6.5 6.5 0 0 0-3.5-5.8"/>',
  pin: '<path d="M12 21s7-6.2 7-11.5a7 7 0 0 0-14 0C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 7l8 6 8-6"/>',
  phone: '<rect x="7" y="2.5" width="10" height="19" rx="3"/><path d="M11 18h2"/>',
  qr: '<rect x="4" y="4" width="6" height="6" rx="1.5"/><rect x="14" y="4" width="6" height="6" rx="1.5"/><rect x="4" y="14" width="6" height="6" rx="1.5"/><path d="M14 14h2v2"/><path d="M20 14v.01"/><path d="M14 20h.01"/><path d="M17 17h3v3h-3z"/>',
  trend: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  energy: '<path d="M9 3v4"/><path d="M15 3v4"/><path d="M6 7h12v3a6 6 0 0 1-12 0V7z"/><path d="M12 16v5"/>',
} as const;

export type IconName = keyof typeof icons;

const { name, size = 22, class: className = '', draw = false, label } = Astro.props;

// pathLength="1" em cada traço permite a animação draw-stroke via CSS
const markup = icons[name].replace(/<(path|circle|rect|line|polyline)\s/g, '<$1 pathLength="1" ');
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  data-draw={draw ? '' : undefined}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={markup}
/>

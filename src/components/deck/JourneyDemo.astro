---
/**
 * Demonstração da jornada de compra: lista de etapas (texto real, acessível)
 * + ilustração em traço do totem com um estado por etapa.
 *
 * O estado vem de data-step no elemento raiz. deck.ts avança as etapas
 * enquanto o slide está ativo (só com movimento permitido); as etapas também
 * são botões, então quem apresenta pode parar em qualquer uma.
 * Sem JS, a lista completa é o conteúdo e a ilustração mostra a etapa final.
 */
import { JOURNEY } from '@lib/presentation';

const bars = [
  [292, 2], [297, 1], [300, 3], [306, 1], [309, 2], [314, 1], [317, 4], [324, 1], [327, 2],
  [332, 1], [335, 3], [341, 1], [344, 2], [349, 3], [355, 1], [358, 2], [363, 1], [366, 3], [372, 2],
];

// Padrão decorativo de "cobrança Pix" (não é um código legível — o QR real fica no último slide)
const pix: [number, number][] = [];
const seed = [0b1011101, 0b0110010, 0b1101011, 0b0010110, 0b1110101, 0b0101001, 0b1001111];
seed.forEach((row, y) => {
  for (let x = 0; x < 7; x++) if ((row >> x) & 1) pix.push([x, y]);
});
---

<div class="journey" data-journey data-step="4">
  <div class="journey-main">
  <slot />
  <ol class="journey-steps">
    {
      JOURNEY.map((s, i) => (
        <li>
          <button type="button" class="journey-step" data-journey-step={i + 1} aria-pressed={i === 3 ? 'true' : 'false'}>
            <span class="journey-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="journey-copy">
              <span class="journey-title">{s.title}</span>
              <span class="journey-text">{s.text}</span>
            </span>
          </button>
        </li>
      ))
    }
  </ol>
  </div>

  <div class="journey-art" aria-hidden="true">
    <svg viewBox="0 0 480 520" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <!-- prateleira -->
      <g class="j-shelf">
        <path d="M30 150h170M30 250h170M30 350h170" />
        <rect x="44" y="112" width="34" height="38" rx="5" />
        <rect x="88" y="104" width="26" height="46" rx="5" />
        <rect x="124" y="118" width="52" height="32" rx="5" />
        <rect x="44" y="206" width="48" height="44" rx="5" />
        <rect x="140" y="212" width="40" height="38" rx="5" />
        <rect x="44" y="312" width="30" height="38" rx="5" />
        <rect x="84" y="306" width="40" height="44" rx="5" />
        <rect x="134" y="318" width="46" height="32" rx="5" />
      </g>
      <!-- produto escolhido -->
      <g class="j-item">
        <rect x="100" y="204" width="32" height="46" rx="6" class="j-item-box" />
        <path d="M108 236h4M114 236h2M118 236h6M108 240h16" class="j-item-code" />
      </g>

      <!-- totem -->
      <rect x="250" y="40" width="190" height="440" rx="26" class="j-body" />
      <rect x="270" y="64" width="150" height="220" rx="14" class="j-screen" />
      <rect x="300" y="318" width="90" height="18" rx="9" class="j-reader" />
      <path d="M314 327h62" class="j-reader-light" />
      <path d="M296 480v18M394 480v18M282 498h126" class="j-line" />

      <!-- 1: entrada (portas que se abrem) -->
      <g class="j-state j-s1">
        <rect x="305" y="104" width="80" height="140" rx="6" class="j-line" />
        <rect x="309" y="108" width="36" height="132" rx="3" class="j-leaf j-leaf-l" />
        <rect x="345" y="108" width="36" height="132" rx="3" class="j-leaf j-leaf-r" />
        <path d="M345 128v92" class="j-glow" />
      </g>

      <!-- 2: escolha (cesta na tela) -->
      <g class="j-state j-s2">
        <path d="M312 150h66l-7 52a8 8 0 0 1-8 7h-36a8 8 0 0 1-8-7z" class="j-line" />
        <path d="M326 150l12-22M364 150l-12-22" class="j-line" />
        <circle cx="345" cy="178" r="5" class="j-dot" />
      </g>

      <!-- 3: leitura do código -->
      <g class="j-state j-s3">
        {bars.map(([x, w]) => <rect x={x} y="110" width={w} height="74" rx="0.5" class="j-bar" />)}
        <path d="M290 222h110M290 238h70" class="j-faint" />
        <path d="M280 147h130" class="j-scan" />
      </g>

      <!-- 4: Pix + confirmação -->
      <g class="j-state j-s4">
        <g class="j-pix">
          <rect x="305" y="92" width="80" height="80" rx="6" class="j-faint" />
          {pix.map(([x, y]) => <rect x={311 + x * 10} y={98 + y * 10} width="8" height="8" rx="1.5" class="j-pix-dot" />)}
          <text x="345" y="200" text-anchor="middle" class="j-pix-label">Pix</text>
        </g>
        <g class="j-done">
          <circle cx="345" cy="174" r="44" pathLength="1" class="j-check-c" />
          <path d="M325 175l14 14 27-30" pathLength="1" class="j-check" />
        </g>
      </g>
    </svg>
  </div>
</div>

<style>
  @layer components {
    .journey {
      display: grid;
      gap: clamp(24px, 4vw, 64px);
      align-items: center;
    }

    @media (min-width: 900px) {
      .journey {
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      }
    }

    .journey-main {
      display: grid;
      gap: clamp(20px, 4svh, 40px);
    }

    .journey-steps {
      display: grid;
      border-top: 1px solid var(--line);
    }

    .journey-step {
      width: 100%;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 20px;
      align-items: baseline;
      padding: clamp(10px, 1.6svh, 18px) 4px;
      border-bottom: 1px solid var(--line);
      text-align: left;
      cursor: pointer;
      color: var(--fg-2);
      transition: color var(--dur-xs) var(--ease-soft);
    }

    .journey-step:hover {
      color: var(--fg);
    }

    .journey-num {
      font-family: var(--font-title);
      font-size: 0.875rem;
      font-variant-numeric: tabular-nums;
      color: var(--fg-3);
    }

    .journey-copy {
      display: grid;
      gap: 4px;
    }

    .journey-title {
      font-family: var(--font-title);
      font-size: var(--deck-h3);
      font-weight: 500;
      letter-spacing: -0.025em;
      line-height: 1.15;
      color: var(--fg);
    }

    .journey-text {
      font-size: var(--deck-body);
      line-height: 1.5;
    }

    /* Etapa ativa: número verde + barra lateral (só com JS — sem JS, tudo tem o mesmo peso) */
    :global(.js) .journey-step[aria-pressed='false'] .journey-title {
      color: var(--fg-2);
    }

    :global(.js) .journey-step[aria-pressed='true'] .journey-num {
      color: var(--jg-green);
    }

    :global(.js) .journey-step[aria-pressed='true'] {
      box-shadow: inset 2px 0 0 var(--jg-green);
      padding-left: 18px;
    }

    .journey-art {
      max-width: min(480px, 60svh);
      width: 100%;
      margin-inline: auto;
    }

    @media (max-width: 899px) {
      .journey-art {
        max-width: 280px;
      }
    }

    .journey-art svg {
      width: 100%;
      height: auto;
      overflow: visible;
    }

    /* traços */
    .j-shelf,
    .j-line {
      stroke: rgba(255, 253, 252, 0.38);
      stroke-width: 1.5;
    }

    .j-faint {
      stroke: rgba(255, 253, 252, 0.2);
      stroke-width: 1.5;
    }

    .j-body {
      stroke: rgba(255, 253, 252, 0.42);
      stroke-width: 1.5;
      fill: var(--jg-ink-2);
    }

    .j-screen {
      fill: var(--jg-black);
      stroke: rgba(255, 253, 252, 0.14);
      stroke-width: 1.5;
    }

    .j-reader {
      stroke: rgba(255, 253, 252, 0.38);
      stroke-width: 1.5;
    }

    .j-reader-light {
      stroke: var(--jg-green);
      stroke-width: 2;
      opacity: 0.3;
      transition: opacity var(--dur-s) var(--ease-soft);
    }

    .journey[data-step='3'] .j-reader-light {
      opacity: 1;
    }

    /* produto: sai da prateleira (2) e vai até o leitor (3) */
    .j-item {
      transition: transform 0.6s var(--ease-in-out);
    }

    .j-item-box {
      fill: var(--jg-ink-3);
      stroke: var(--jg-green);
      stroke-width: 1.75;
    }

    .j-item-code {
      stroke: var(--jg-offwhite);
      stroke-width: 1.5;
    }

    .journey[data-step='2'] .j-item {
      transform: translate(0, -24px);
    }

    .journey[data-step='3'] .j-item {
      transform: translate(196px, 74px);
    }

    .journey[data-step='4'] .j-item {
      transform: translate(196px, 74px);
      opacity: 0;
      transition:
        transform 0.6s var(--ease-in-out),
        opacity 0.4s var(--ease-soft);
    }

    /* estados da tela */
    .j-state {
      opacity: 0;
      transition: opacity var(--dur-s) var(--ease-soft);
    }

    .journey[data-step='1'] .j-s1,
    .journey[data-step='2'] .j-s2,
    .journey[data-step='3'] .j-s3,
    .journey[data-step='4'] .j-s4 {
      opacity: 1;
    }

    .j-leaf {
      fill: var(--jg-ink-3);
      stroke: rgba(255, 253, 252, 0.38);
      stroke-width: 1.5;
      transition: transform 0.9s var(--ease-in-out) 0.2s;
    }

    .journey[data-step='1'] .j-leaf-l {
      transform: translateX(-26px);
    }

    .journey[data-step='1'] .j-leaf-r {
      transform: translateX(26px);
    }

    .j-glow {
      stroke: var(--jg-green);
      stroke-width: 2;
    }

    .j-dot {
      fill: var(--jg-green);
    }

    .j-bar {
      fill: var(--jg-offwhite);
      opacity: 0.85;
    }

    .j-scan {
      stroke: var(--jg-green);
      stroke-width: 2.5;
    }

    .journey[data-step='3'] .j-scan {
      animation: j-sweep 1.4s var(--ease-in-out) infinite alternate;
    }

    @keyframes j-sweep {
      from {
        transform: translateY(-34px);
      }
      to {
        transform: translateY(34px);
      }
    }

    .j-pix-dot {
      fill: var(--jg-offwhite);
    }

    .j-pix-label {
      fill: var(--jg-mist);
      font-family: var(--font-display);
      font-size: 14px;
      letter-spacing: 0.08em;
    }

    /* Pix aparece; depois, a confirmação se desenha sobre ele */
    .j-pix {
      transition: opacity 0.35s var(--ease-soft) 1.3s;
    }

    .journey[data-step='4'] .j-pix {
      opacity: 0;
    }

    .j-check-c,
    .j-check {
      stroke: var(--jg-green);
      stroke-width: 2.5;
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    .journey[data-step='4'] .j-check-c {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 0.6s var(--ease-in-out) 1.5s;
    }

    .journey[data-step='4'] .j-check {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 0.4s var(--ease-out-expo) 1.95s;
    }

    /* Sem movimento (preferência do usuário, sem JS ou impressão): estado final direto */
    :global(html:not(.motion)) .journey *,
    :global(html:not(.motion)) .journey *::before {
      transition: none !important;
      animation: none !important;
    }

    @media print {
      .journey {
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      }

      .journey-art {
        max-width: 92mm;
      }

      .journey * {
        transition: none !important;
        animation: none !important;
      }
    }
  }
</style>

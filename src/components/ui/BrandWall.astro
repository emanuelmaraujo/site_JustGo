---
/**
 * Parede de marcas da curadoria, por categoria.
 * Só nomes, em tipografia da Just Go (sem logotipos de terceiros), sempre com a
 * ressalva de disponibilidade (BRANDS_DISCLAIMER).
 *
 * compact → versão da apresentação: menos texto, cabe em um slide 16:9.
 */
import { BRAND_GROUPS, BRANDS_DISCLAIMER } from '@lib/brands';

interface Props {
  compact?: boolean;
  class?: string;
  /** Atributo extra para coreografias (ex.: data-a-brand na apresentação). */
  itemAttr?: string;
}

const { compact = false, class: className = '', itemAttr } = Astro.props;
const groups = compact ? BRAND_GROUPS.filter((g) => g.id !== 'casa') : BRAND_GROUPS;
const attr = itemAttr ? { [itemAttr]: '' } : {};
---

<div class:list={['bw', compact && 'bw-compact', className]}>
  <ul class="bw-grid">
    {
      groups.map((g) => (
        <li class="bw-group" {...attr}>
          <p class="bw-title">
            <span>{g.title}</span>
            <span class="bw-count" aria-hidden="true">
              {String(g.brands.length).padStart(2, '0')}
            </span>
          </p>
          {!compact && <p class="bw-note">{g.note}</p>}
          <ul class="bw-names" aria-label={`Marcas de referência: ${g.title}`}>
            {(compact ? g.brands.slice(0, 5) : g.brands).map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
  <p class="bw-disclaimer">{BRANDS_DISCLAIMER}</p>
</div>

<style>
  @layer components {
    .bw-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
      border-top: 1px solid var(--line);
    }

    .bw-group {
      padding: clamp(20px, 2.6vw, 32px) clamp(0px, 1.6vw, 24px) clamp(20px, 2.6vw, 32px) 0;
      border-bottom: 1px solid var(--line);
    }

    .bw-title {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
      font-family: var(--font-display);
      font-size: var(--fs-label);
      font-weight: 500;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--fg-2);
    }

    .bw-count {
      font-variant-numeric: tabular-nums;
      color: var(--accent-text);
    }

    .bw-note {
      margin-top: 8px;
      font-size: var(--fs-small);
      color: var(--fg-3);
    }

    .bw-names {
      margin-top: 18px;
      display: flex;
      flex-wrap: wrap;
      gap: 6px 18px;
    }

    .bw-names li {
      font-family: var(--font-title);
      font-size: clamp(1.15rem, 1.6vw, 1.5rem);
      font-weight: 500;
      letter-spacing: -0.025em;
      line-height: 1.25;
      color: var(--fg);
    }

    .bw-disclaimer {
      margin-top: 20px;
      max-width: 90ch;
      font-size: 0.8125rem;
      line-height: 1.5;
      color: var(--fg-3);
    }

    /* Apresentação: quatro colunas, nomes menores, cabe em 16:9 */
    .bw-compact .bw-grid {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    }

    .bw-compact .bw-group {
      padding-block: clamp(12px, 2.2svh, 24px);
    }

    .bw-compact .bw-names {
      margin-top: 10px;
      gap: 2px 14px;
    }

    .bw-compact .bw-names li {
      font-size: var(--deck-h3, 1.25rem);
      line-height: 1.3;
    }

    .bw-compact .bw-title {
      font-size: 0.8125rem;
    }

    .bw-compact .bw-disclaimer {
      margin-top: 12px;
      font-size: 0.75rem;
    }

    @media (min-width: 1024px) {
      .bw-compact .bw-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    @media print {
      .bw-compact .bw-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }
  }
</style>

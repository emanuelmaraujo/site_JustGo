---
/**
 * Fotografia com otimização automática (AVIF/WebP, srcset) a partir de
 * src/assets/fotos/<name>.(jpg|png|webp|avif).
 *
 * Enquanto o arquivo não existir, renderiza uma composição gráfica da marca
 * (padrão + símbolo) na proporção final — nunca um texto técnico visível ao público
 * nem uma imagem que finja ser uma loja real. O nome esperado fica em data-photo-missing
 * (inspecionável no HTML) e a lista de pendências está em docs/pendencias-conteudo.md.
 *
 * kind         → 'photo' (padrão, sem legenda) · 'illustrative' ("Imagem ilustrativa")
 *                · 'concept' ("Projeto conceitual" — renders 3D, nunca uma loja real)
 * illustrative → atalho legado para kind="illustrative"
 * unveil       → revelação com máscara ao entrar na tela (image-unveil)
 * parallax     → a foto se move mais devagar que a moldura (motion.ts)
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import BrandSymbol from '@components/BrandSymbol.astro';

interface Props {
  name: string;
  alt: string;
  ratio?: string;
  sizes?: string;
  priority?: boolean;
  /** Descrição da foto esperada (documentação; não aparece na interface). */
  placeholder?: string;
  illustrative?: boolean;
  kind?: 'photo' | 'illustrative' | 'concept';
  /** Texto da legenda (substitui o rótulo padrão do kind). */
  note?: string;
  unveil?: boolean;
  parallax?: boolean;
  rounded?: boolean;
  class?: string;
  position?: string;
}

const {
  name,
  alt,
  ratio = '4/5',
  sizes = '(min-width: 1024px) 50vw, 100vw',
  priority = false,
  illustrative = false,
  kind: kindProp,
  note: noteProp,
  unveil = false,
  parallax = false,
  rounded = true,
  class: className = '',
  position = 'center',
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/fotos/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const match = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.[^.]+$/, '') === name);
const image = match?.[1].default;

const kind = kindProp ?? (illustrative ? 'illustrative' : 'photo');
const NOTES = { photo: '', illustrative: 'Imagem ilustrativa', concept: 'Projeto conceitual' } as const;
const note = noteProp ?? NOTES[kind];

const allWidths = [480, 720, 960, 1280, 1600, 1920, 2400];
const widths = image ? allWidths.filter((w) => w <= image.width).concat(image.width < 480 ? [image.width] : []) : [];
---

<figure
  class:list={['photo', rounded && 'photo-rounded', className]}
  style={`--ratio:${ratio};--pos:${position}`}
  data-unveil={unveil ? '' : undefined}
  data-parallax={parallax ? '' : undefined}
>
  {
    image ? (
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="photo-img"
      />
    ) : (
      <div class="photo-ph" role="img" aria-label={alt} data-photo-missing={name}>
        <span class="photo-ph-grid" aria-hidden="true"></span>
        <BrandSymbol class="photo-ph-symbol" tone="ink" />
        <span class="photo-ph-line" aria-hidden="true"></span>
      </div>
    )
  }
  {note && image && <figcaption class="photo-note">{note}</figcaption>}
</figure>

<style>
  @layer components {
    .photo {
      position: relative;
      aspect-ratio: var(--ratio);
      overflow: hidden;
      background: var(--jg-ink-2);
      isolation: isolate;
    }

    .photo-rounded {
      border-radius: var(--r-media);
    }

    .photo :global(picture),
    .photo :global(.photo-img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .photo :global(.photo-img) {
      object-fit: cover;
      object-position: var(--pos);
    }

    .photo[data-parallax] :global(.photo-img) {
      inset: -8% 0;
      height: 116%;
    }

    .photo-ph {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 24px;
      background:
        radial-gradient(120% 80% at 70% 20%, rgba(160, 226, 97, 0.06), transparent 60%),
        linear-gradient(160deg, var(--jg-ink-3), var(--jg-black));
      border: 1px solid rgba(255, 253, 252, 0.08);
      border-radius: inherit;
    }

    .photo-ph :global(.photo-ph-symbol) {
      position: absolute;
      width: 46%;
      max-width: 320px;
      opacity: 0.9;
    }

    /* Grade fina de arquitetura (planta baixa) — composição neutra da marca */
    .photo-ph-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 253, 252, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 253, 252, 0.035) 1px, transparent 1px);
      background-size: 48px 48px;
      background-position: center;
      mask-image: radial-gradient(80% 70% at 50% 50%, #000 30%, transparent 100%);
    }

    .photo-ph-line {
      position: absolute;
      left: 12%;
      right: 12%;
      bottom: 14%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(160, 226, 97, 0.45), transparent);
    }

    .photo-note {
      position: absolute;
      right: 14px;
      bottom: 12px;
      z-index: 2;
      padding: 4px 10px;
      border-radius: var(--r-pill);
      background: rgba(1, 5, 2, 0.55);
      backdrop-filter: blur(8px);
      color: var(--jg-mist);
      font-family: var(--font-display);
      font-size: 0.6875rem;
      letter-spacing: 0.04em;
    }
  }
</style>

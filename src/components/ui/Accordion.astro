---
/**
 * Accordion acessível: botão com aria-expanded + região.
 * Altura animada de verdade (grid-template-rows 0fr → 1fr), ícone "+" que vira "×"
 * (a rotação é do ícone, nunca da marca). Sem JS, tudo aparece aberto.
 */
import Icon from '@components/Icon.astro';

interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
  id: string;
  headingLevel?: 'h3' | 'h4';
}

const { items, id, headingLevel: H = 'h3' } = Astro.props;
---

<div class="acc" data-accordion>
  {
    items.map((item, i) => (
      <div class="acc-item">
        <H class="acc-h">
          <button
            type="button"
            class="acc-btn"
            id={`${id}-b${i}`}
            aria-expanded="false"
            aria-controls={`${id}-p${i}`}
          >
            <span class="acc-q">{item.question}</span>
            <span class="acc-ico" aria-hidden="true">
              <Icon name="plus" size={18} />
            </span>
          </button>
        </H>
        <div class="acc-panel" id={`${id}-p${i}`} role="region" aria-labelledby={`${id}-b${i}`}>
          <div class="acc-inner">
            <p set:html={item.answer} />
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  @layer components {
    .acc {
      border-top: 1px solid var(--line);
    }

    .acc-item {
      border-bottom: 1px solid var(--line);
    }

    .acc-h {
      font: inherit;
      letter-spacing: normal;
    }

    .acc-btn {
      width: 100%;
      min-height: 76px;
      padding: 22px 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      text-align: left;
      font-family: var(--font-display);
      font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
      font-weight: 500;
      letter-spacing: -0.01em;
      line-height: 1.35;
      color: var(--fg);
    }

    .acc-ico {
      flex: none;
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      border: 1px solid var(--line);
      transition:
        transform var(--dur-s) var(--ease-out-expo),
        background-color var(--dur-xs) var(--ease-soft),
        color var(--dur-xs) var(--ease-soft);
    }

    @media (hover: hover) {
      .acc-btn:hover .acc-ico {
        background: var(--fg);
        color: var(--bg);
      }
    }

    .acc-inner {
      overflow: hidden;
    }

    .acc-inner p {
      padding: 0 56px 28px 0;
      max-width: 68ch;
      color: var(--fg-2);
    }

    :global(.js) .acc-panel {
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      transition:
        grid-template-rows var(--dur-s) var(--ease-in-out),
        visibility 0s linear var(--dur-s);
    }

    :global(.js) .acc-inner p {
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity var(--dur-s) var(--ease-soft),
        transform var(--dur-s) var(--ease-out-expo);
    }

    :global(.js) .acc-item.is-open .acc-panel {
      grid-template-rows: 1fr;
      visibility: visible;
      transition:
        grid-template-rows var(--dur-s) var(--ease-in-out),
        visibility 0s;
    }

    :global(.js) .acc-item.is-open .acc-inner p {
      opacity: 1;
      transform: none;
      transition-delay: 120ms;
    }

    .acc-item.is-open .acc-ico {
      transform: rotate(45deg);
    }

    @media (max-width: 599px) {
      .acc-inner p {
        padding-right: 0;
      }
    }
  }
</style>

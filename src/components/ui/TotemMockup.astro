---
/**
 * Ilustração em traço do totem de autoatendimento, com três estados:
 * 1 porta abrindo · 2 código de barras com a linha de leitura verde · 3 check que se desenha.
 * O estado ativo vem de data-state no elemento (StickySteps troca via script).
 */
interface Props {
  state?: 1 | 2 | 3;
  class?: string;
}
const { state = 1, class: className = '' } = Astro.props;

const bars = [
  [100, 3], [106, 1.5], [110, 4], [117, 1.5], [121, 2.5], [127, 1.5], [131, 5], [139, 1.5],
  [143, 3], [149, 1.5], [153, 2], [158, 4], [165, 1.5], [169, 3], [175, 1.5], [179, 2.5],
  [185, 4], [192, 1.5], [196, 2], [201, 3], [207, 1.5], [211, 4], [218, 2],
];
---

<div class:list={['totem', className]} data-state={state} aria-hidden="true">
  <svg viewBox="0 0 320 560" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <!-- corpo -->
    <rect x="40" y="20" width="240" height="500" rx="30" class="t-body" />
    <rect x="64" y="52" width="192" height="300" rx="16" class="t-screen" />
    <!-- leitor -->
    <rect x="108" y="392" width="104" height="20" rx="10" class="t-line" />
    <path d="M124 402h72" class="t-reader" />
    <!-- base -->
    <path d="M96 520v18M224 520v18M80 538h160" class="t-line" />
    <!-- maquininha / aproximação -->
    <rect x="132" y="436" width="56" height="40" rx="10" class="t-line" />
    <path d="M150 456c3-4 3-8 0-12M157 459c5-7 5-15 0-22M164 462c7-10 7-21 0-31" class="t-faint" />

    <!-- estado 1: porta -->
    <g class="t-state t-s1">
      <rect x="108" y="108" width="104" height="184" rx="8" class="t-line" />
      <rect x="112" y="112" width="48" height="176" rx="4" class="t-leaf t-leaf-l" />
      <rect x="160" y="112" width="48" height="176" rx="4" class="t-leaf t-leaf-r" />
      <path d="M160 140v120" class="t-glow" />
    </g>

    <!-- estado 2: código de barras -->
    <g class="t-state t-s2">
      {bars.map(([x, w]) => <rect x={x} y="140" width={w} height="110" rx="0.75" class="t-bar" />)}
      <path d="M92 195h136" class="t-scan" />
    </g>

    <!-- estado 3: pagamento aprovado -->
    <g class="t-state t-s3">
      <circle cx="160" cy="192" r="52" pathLength="1" class="t-check-c" />
      <path d="M136 193l17 17 32-36" pathLength="1" class="t-check" />
      <path d="M128 282h64" class="t-faint" />
    </g>
  </svg>
</div>

<style>
  @layer components {
    .totem {
      width: 100%;
      max-width: 340px;
      margin-inline: auto;
      aspect-ratio: 320 / 560;
    }

    .totem svg {
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .t-body {
      stroke: rgba(255, 253, 252, 0.4);
      stroke-width: 1.5;
      fill: var(--jg-ink-2);
    }

    .t-screen {
      fill: var(--jg-black);
      stroke: rgba(255, 253, 252, 0.14);
      stroke-width: 1.5;
    }

    .t-line {
      stroke: rgba(255, 253, 252, 0.4);
      stroke-width: 1.5;
    }

    .t-faint {
      stroke: rgba(255, 253, 252, 0.22);
      stroke-width: 1.5;
    }

    .t-reader {
      stroke: var(--jg-green);
      stroke-width: 2;
      opacity: 0.35;
    }

    .totem[data-state='2'] .t-reader {
      opacity: 1;
    }

    .t-state {
      opacity: 0;
      transition: opacity var(--dur-s) var(--ease-soft);
    }

    .totem[data-state='1'] .t-s1,
    .totem[data-state='2'] .t-s2,
    .totem[data-state='3'] .t-s3 {
      opacity: 1;
    }

    /* 1 — portas que se abrem para os lados (a metáfora do elevador) */
    .t-leaf {
      fill: var(--jg-ink-3);
      stroke: rgba(255, 253, 252, 0.4);
      stroke-width: 1.5;
      transition: transform 1s var(--ease-in-out) 0.25s;
    }

    .totem[data-state='1'] .t-leaf-l {
      transform: translateX(-34px);
    }

    .totem[data-state='1'] .t-leaf-r {
      transform: translateX(34px);
    }

    .t-glow {
      stroke: var(--jg-green);
      stroke-width: 2;
      opacity: 0;
      transition: opacity 0.6s var(--ease-soft) 0.6s;
    }

    .totem[data-state='1'] .t-glow {
      opacity: 1;
    }

    /* 2 — linha de leitura verde varrendo */
    .t-bar {
      fill: var(--jg-offwhite);
      opacity: 0.85;
    }

    .t-scan {
      stroke: var(--jg-green);
      stroke-width: 2.5;
      filter: drop-shadow(0 0 6px rgba(160, 226, 97, 0.8));
    }

    .totem[data-state='2'] .t-scan {
      animation: t-sweep 2.2s var(--ease-in-out) infinite alternate;
    }

    @keyframes t-sweep {
      from { transform: translateY(-52px); }
      to { transform: translateY(52px); }
    }

    /* 3 — check que se desenha */
    .t-check-c,
    .t-check {
      stroke: var(--jg-green);
      stroke-width: 2.5;
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    .totem[data-state='3'] .t-check-c {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 0.9s var(--ease-in-out) 0.1s;
    }

    .totem[data-state='3'] .t-check {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 0.6s var(--ease-out-expo) 0.8s;
    }

    @media (prefers-reduced-motion: reduce) {
      .totem[data-state='2'] .t-scan {
        animation: none;
      }
    }
  }
</style>

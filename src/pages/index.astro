---
/**
 * Home — "Galeria noturna".
 * Ordem (§7): intro · hero · manifesto · curadoria · como funciona · síndicos ·
 * projeto integrado · segurança · FAQ · CTA final.
 * O depoimento (§7.8) fica omitido até existir um depoimento real e autorizado.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Button from '@components/ui/Button.astro';
import SplitWords from '@components/ui/SplitWords.astro';
import WordLight from '@components/ui/WordLight.astro';
import Photo from '@components/ui/Photo.astro';
import HorizontalGallery from '@components/ui/HorizontalGallery.astro';
import StickySteps from '@components/ui/StickySteps.astro';
import StatCounter from '@components/ui/StatCounter.astro';
import BeforeAfter from '@components/ui/BeforeAfter.astro';
import Icon from '@components/Icon.astro';
import Pattern from '@components/site/Pattern.astro';
import FaqTabs from '@components/site/FaqTabs.astro';
import CtaFinal from '@components/site/CtaFinal.astro';
import Marquee from '@components/site/Marquee.astro';
import { CTA, FACTS, PREMIUM_BRANDS } from '@lib/site';
import { getFaqs, getCuradoria } from '@lib/content';
import { BUY_STEPS } from '@lib/model';
import { serviceSchema, faqPageSchema, localBusinessSchema } from '@lib/schema';

const faqs = await getFaqs();
const curadoria = await getCuradoria();

const schemas = [
  serviceSchema(),
  localBusinessSchema('Brasília', { lat: -15.7975, lng: -47.8919 }),
  faqPageSchema(faqs.all),
];

const model = [
  {
    title: 'Investimos',
    text: 'Projeto, estrutura, equipamentos, tecnologia e estoque. Tudo por nossa conta.',
  },
  {
    title: 'Operamos',
    text: 'Reposição, limpeza, manutenção e monitoramento 24 horas. Sem funcionários do condomínio.',
  },
  {
    title: 'Você valoriza',
    text: 'Uma amenity que eleva o padrão do empreendimento e o dia a dia de quem mora nele.',
  },
];

const security = [
  { icon: 'camera', title: 'Câmeras 24h', text: 'Circuito em alta definição, acompanhado remotamente pela nossa equipe.' },
  { icon: 'key', title: 'Controle de acesso', text: 'Livre, por QR Code ou pelo aplicativo do condomínio — vocês escolhem.' },
  { icon: 'lock', title: 'Adega com trava', text: 'Bebidas alcoólicas só após verificação de maioridade.' },
  { icon: 'shield', title: 'Seguro próprio', text: 'Contra danos e furtos, contratado e pago por nós.' },
  { icon: 'chat', title: 'Suporte em tempo real', text: 'Atendimento pelo WhatsApp, com estorno na hora quando necessário.' },
] as const;
---

<BaseLayout
  fullTitle="Mercado Autônomo Premium para Condomínios em Brasília | Just Go Market"
  description="Mercado autônomo 24h com curadoria premium para condomínios de alto padrão em Brasília. Instalado e operado pela Just Go Market, sem custo para o condomínio."
  schemas={schemas}
  intro
  floors
  pageClass="page-home"
>
  <!-- 7.1 Hero -->
  <section class="hero theme-dark" data-floor="08" data-floor-label="Entrada">
    <div class="container hero-top">
      <p class="hero-status">
        <span class="hero-live"><span class="hero-dot" aria-hidden="true"></span> Aberto agora</span>
        <span aria-hidden="true">·</span>
        <time data-clock>24h</time>
        <span aria-hidden="true">·</span>
        <span>Brasília</span>
      </p>

      <div class="hero-grid">
        <div data-parallax-y="-15">
          <SplitWords tag="h1" immediate class="hero-title">
            A conveniência de <span class="hl">alto padrão,</span> a um elevador de distância.
          </SplitWords>
        </div>
        <div class="hero-side">
          <p class="lead">
            Mercado autônomo 24h com curadoria premium — instalado e operado por nós, sem custo para o condomínio.
          </p>
          <div class="btn-row">
            <Button href={CTA.primaryHref} track="cta_agendar_visita" origin="hero" data-lead-open magnetic>
              {CTA.primary}
            </Button>
            <Button href="/curadoria" variant="secondary" icon="arrow-right">Ver a curadoria</Button>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-media" data-hero-media>
      <Photo
        name="hero-loja-noite"
        alt="Loja Just Go integrada ao lobby de um condomínio de alto padrão, à noite"
        placeholder="Loja integrada ao lobby do condomínio, à noite, luz quente, sem pessoas"
        ratio="16/9"
        sizes="100vw"
        priority
        rounded={false}
        illustrative
        class="hero-photo"
      />
    </div>
  </section>

  <!-- 7.2 Manifesto -->
  <Section theme="light" class="manifesto" floor="07" floorLabel="Manifesto" label="Manifesto">
    <div class="container">
      <Eyebrow>Manifesto</Eyebrow>
      <WordLight
        class="manifesto-text"
        text="Acreditamos que o bem mais precioso é o tempo. Por isso levamos o essencial para dentro do seu condomínio — com curadoria, discrição e cuidado."
        highlight={['tempo.']}
      />
      <p class="manifesto-sign">Tempo de sobra para o que importa.</p>
    </div>
  </Section>

  <!-- 7.3 Curadoria -->
  <Section theme="dark" id="curadoria" class="curadoria" floor="06" floorLabel="Curadoria" flush>
    <div class="curadoria-wrap" data-track-view="curadoria_view">
      <div class="container section-head split">
        <div>
          <Eyebrow>Curadoria</Eyebrow>
          <SplitWords tag="h2" class="mt-m">Um empório inteiro no térreo do seu prédio.</SplitWords>
        </div>
        <p class="lead" data-reveal>
          Não é um mercado comum. Cada loja recebe uma seleção pensada para quem mora ali — e ajustada ao que os
          moradores pedem.
        </p>
      </div>

      <HorizontalGallery
        label="Universos da curadoria"
        items={curadoria.map((c) => ({
          title: c.title,
          kicker: c.kicker,
          text: c.text,
          photo: c.photo,
          note: c.confirm ? `[CONFIRMAR] ${c.confirm}` : undefined,
        }))}
      />

      {PREMIUM_BRANDS.length > 0 && <Marquee brands={PREMIUM_BRANDS} />}

      <div class="container curadoria-foot">
        <a href="/curadoria" class="link-arrow">Conhecer a curadoria <Icon name="arrow-right" size={14} /></a>
      </div>
    </div>
  </Section>

  <!-- 7.4 Como funciona -->
  <Section theme="ink" id="como-funciona" floor="05" floorLabel="Como funciona">
    <div class="container">
      <div class="section-head split">
        <div>
          <Eyebrow>Como funciona</Eyebrow>
          <SplitWords tag="h2" class="mt-m">Entre. Escolha. Siga.</SplitWords>
        </div>
        <p class="lead" data-reveal>Sem fila, sem caixa, sem aplicativo para comprar. Ir, pegar e seguir.</p>
      </div>
      <StickySteps steps={BUY_STEPS} />
    </div>
  </Section>

  <!-- 7.5 Para síndicos -->
  <Section theme="light" id="para-sindicos" floor="04" floorLabel="Síndicos">
    <div class="container">
      <div class="section-head split">
        <div>
          <Eyebrow>Para síndicos</Eyebrow>
          <SplitWords tag="h2" class="mt-m">Nós cuidamos de tudo. O condomínio só ganha.</SplitWords>
        </div>
        <p class="lead" data-reveal>
          Um mercado autônomo para condomínios em Brasília sem investimento, sem gestão e sem vínculo trabalhista.
        </p>
      </div>

      <div class="model">
        <div class="draw-line model-line" aria-hidden="true"></div>
        <ol class="model-list">
          {
            model.map((m, i) => (
              <li class="model-item" data-reveal>
                <p class="model-num" aria-hidden="true" data-split>
                  <span class="sw"><span style={`--i:${i}`}>{String(i + 1).padStart(2, '0')}</span></span>
                </p>
                <h3>{m.title}</h3>
                <p>{m.text}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="model-note" data-reveal>
        <p class="model-note-text">
          {FACTS.area} e um ponto de energia — <span class="hl">com consumo reembolsado.</span>
        </p>
        <a href="/para-sindicos" class="link-arrow">Entenda o modelo <Icon name="arrow-right" size={14} /></a>
      </div>

      <div class="stats">
        <StatCounter value={24} suffix="h" label="Operação" note="Todos os dias, inclusive feriados" />
        <StatCounter value={0} prefix="R$" label="Investimento do condomínio" note="Estrutura e estoque por nossa conta" />
        <StatCounter value={15} suffix="m²" label="Espaço necessário" note="Mais um ponto de energia" />
        <StatCounter value={FACTS.contractMonths} suffix="meses" label="Prazo de contrato" note="Renovação automática" />
      </div>
    </div>
  </Section>

  <!-- 7.6 Projeto integrado à arquitetura -->
  <Section theme="paper" id="projeto" floor="03" floorLabel="Projeto">
    <div class="container">
      <div class="section-head split">
        <div>
          <Eyebrow>Projeto integrado</Eyebrow>
          <SplitWords tag="h2" class="mt-m">Cada loja é desenhada para o seu condomínio.</SplitWords>
        </div>
        <p class="lead" data-reveal>
          Nada de módulo padronizado de franquia. Materiais e acabamentos escolhidos para conversar com a arquitetura
          do seu prédio.
        </p>
      </div>

      <div data-reveal>
        <BeforeAfter
          before={{
            name: 'projeto-antes',
            alt: 'Nicho vazio no hall de um condomínio, antes da instalação',
            placeholder: 'Antes — nicho vazio no hall do condomínio, mesmo enquadramento',
          }}
          after={{
            name: 'projeto-depois',
            alt: 'O mesmo nicho com a loja Just Go instalada',
            placeholder: 'Depois — o mesmo nicho com a loja instalada',
          }}
        />
      </div>

      <ol class="project-steps">
        <li data-reveal>
          <span class="index-num">01</span>
          <h3>Visita técnica</h3>
          <p>Avaliamos o espaço, a circulação e o perfil dos moradores.</p>
        </li>
        <li data-reveal>
          <span class="index-num">02</span>
          <h3>Projeto 3D</h3>
          <p>Em {FACTS.projectDays}, com layout, materiais e mix de produtos sugerido.</p>
        </li>
        <li data-reveal>
          <span class="index-num">03</span>
          <h3>Instalação limpa</h3>
          <p>De {FACTS.installDays} após a aprovação, sem obra civil.</p>
        </li>
      </ol>
    </div>
  </Section>

  <!-- 7.7 Segurança e discrição -->
  <Section theme="dark" id="seguranca" class="security" floor="02" floorLabel="Segurança">
    <Pattern id="pattern-security" opacity={0.035} size={168} />
    <div class="container security-inner">
      <div class="section-head split">
        <div>
          <Eyebrow>Segurança e discrição</Eyebrow>
          <SplitWords tag="h2" class="mt-m">O risco é nosso, não do condomínio.</SplitWords>
        </div>
        <p class="lead" data-reveal>
          Várias camadas de proteção, operando em silêncio. Se algo acontece, nossa equipe resolve — sem envolver a
          administração.
        </p>
      </div>
      <ul class="security-grid">
        {
          security.map((s) => (
            <li class="security-item" data-reveal>
              <span class="card-icon">
                <Icon name={s.icon} size={22} draw />
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- 7.9 FAQ -->
  <Section theme="light" id="duvidas" floor="01" floorLabel="Dúvidas">
    <div class="container faq-home">
      <div class="faq-home-head">
        <Eyebrow>Dúvidas frequentes</Eyebrow>
        <SplitWords tag="h2" class="mt-m">Dúvidas sobre o mercado autônomo no condomínio.</SplitWords>
        <a href="/faq" class="link-arrow mt-m">Ver todas as perguntas <Icon name="arrow-right" size={14} /></a>
      </div>
      <div data-reveal>
        <FaqTabs id="faq-home" sindico={faqs.featured.sindico} morador={faqs.featured.morador} />
      </div>
    </div>
  </Section>

  <!-- 7.10 CTA final -->
  <CtaFinal />
</BaseLayout>

<style>
  @layer components {
    /* ---------- Hero ---------- */
    .hero {
      padding-top: calc(var(--header-h) + clamp(40px, 7vw, 96px));
      overflow: clip;
    }

    .hero-status {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      font-family: var(--font-display);
      font-size: 0.8125rem;
      letter-spacing: 0.04em;
      color: var(--fg-2);
      font-variant-numeric: tabular-nums;
    }

    .hero-live {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--fg);
    }

    .hero-dot {
      position: relative;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--jg-green);
    }

    .hero-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--jg-green);
      animation: live 2.4s var(--ease-out-expo) infinite;
    }

    @keyframes live {
      0% {
        transform: scale(1);
        opacity: 0.7;
      }
      100% {
        transform: scale(3.2);
        opacity: 0;
      }
    }

    .hero-grid {
      margin-top: clamp(28px, 4vw, 48px);
      display: grid;
      gap: 40px;
    }

    .hero-title {
      max-width: 13ch;
    }

    .hero-side {
      display: grid;
      gap: 32px;
      align-content: end;
    }

    @media (min-width: 1024px) {
      .hero-grid {
        grid-template-columns: 8fr 4fr;
        column-gap: 56px;
        align-items: end;
      }

      .hero-side {
        padding-bottom: 0.7em;
      }
    }

    :global(.motion) .hero-side,
    :global(.motion) .hero-status {
      animation: hero-in var(--dur-l) var(--ease-out-expo) both;
    }

    :global(.motion) .hero-status {
      animation-delay: 100ms;
    }

    :global(.motion) .hero-side {
      animation-delay: 650ms;
    }

    /* Na primeira visita, o hero começa depois que as portas se abrem */
    :global(.intro-first) .hero {
      --split-delay: 1150ms;
    }

    :global(.intro-first) .hero-status {
      animation-delay: 1200ms;
    }

    :global(.intro-first) .hero-side {
      animation-delay: 1700ms;
    }

    @keyframes hero-in {
      from {
        opacity: 0;
        transform: translateY(var(--reveal-distance));
      }
    }

    .hero-media {
      margin-top: clamp(56px, 8vw, 104px);
    }

    :global(.motion) .hero-media {
      clip-path: inset(0% 7% 0% 7% round 32px);
    }

    :global(html:not(.motion)) .hero-media {
      padding-inline: var(--gutter);
    }

    :global(html:not(.motion)) .hero-media :global(.hero-photo) {
      border-radius: var(--r-media);
    }

    @media (max-width: 767px) {
      .hero-media :global(.hero-photo) {
        aspect-ratio: 4 / 5;
      }

      :global(.motion) .hero-media {
        clip-path: inset(0% 4% 0% 4% round 24px);
      }
    }

    /* ---------- Manifesto ---------- */
    .manifesto :global(.manifesto-text) {
      margin-top: 40px;
      max-width: 22ch;
      font-family: var(--font-title);
      font-size: var(--fs-statement);
      font-weight: 500;
      line-height: 1.12;
      letter-spacing: -0.035em;
      color: var(--fg);
    }

    .manifesto-sign {
      margin-top: 48px;
      font-family: var(--font-display);
      color: var(--fg-2);
    }

    @media (min-width: 1024px) {
      .manifesto {
        min-height: 100vh;
        display: flex;
        align-items: center;
      }

      .manifesto > .container {
        width: 100%;
      }
    }

    /* ---------- Curadoria ---------- */
    .curadoria-wrap {
      padding-block: var(--section-y);
    }

    .curadoria-foot {
      margin-top: 56px;
    }

    /* ---------- Modelo (síndicos) ---------- */
    .model {
      position: relative;
    }

    .model-line {
      position: absolute;
      left: 0;
      right: 0;
      top: 26px;
      display: none;
    }

    .model-list {
      display: grid;
      gap: 40px;
    }

    .model-num {
      font-family: var(--font-title);
      font-size: 3.25rem;
      font-weight: 500;
      line-height: 1;
      letter-spacing: -0.05em;
      color: var(--fg);
    }

    .model-num .sw {
      background: var(--bg);
      padding-right: 16px;
    }

    .model-item h3 {
      margin-top: 28px;
    }

    .model-item p:last-child {
      margin-top: 12px;
      max-width: 32ch;
    }

    @media (min-width: 768px) {
      .model-line {
        display: block;
      }

      .model-list {
        grid-template-columns: repeat(3, 1fr);
        gap: 32px;
      }
    }

    .model-note {
      margin-top: clamp(56px, 7vw, 96px);
      padding-top: 32px;
      border-top: 1px solid var(--line);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 16px 40px;
    }

    .model-note-text {
      font-family: var(--font-title);
      font-size: clamp(1.4rem, 2.6vw, 2.1rem);
      font-weight: 500;
      letter-spacing: -0.03em;
      line-height: 1.2;
      color: var(--fg);
      max-width: 26ch;
    }

    .stats {
      margin-top: clamp(64px, 8vw, 112px);
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 24px;
    }

    @media (min-width: 1024px) {
      .stats {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    /* ---------- Projeto ---------- */
    .project-steps {
      margin-top: 48px;
      display: grid;
      gap: 32px;
    }

    .project-steps h3 {
      margin-top: 12px;
    }

    .project-steps p {
      margin-top: 8px;
      max-width: 34ch;
    }

    @media (min-width: 768px) {
      .project-steps {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    /* ---------- Segurança ---------- */
    .security {
      overflow: hidden;
    }

    .security-inner {
      position: relative;
      z-index: 1;
    }

    .security-grid {
      display: grid;
      gap: 0;
      border-top: 1px solid var(--line);
    }

    .security-item {
      padding: 32px 0;
      border-bottom: 1px solid var(--line);
      display: grid;
      grid-template-columns: 48px 1fr;
      column-gap: 24px;
      align-items: start;
    }

    .security-item :global(.card-icon) {
      grid-row: span 2;
      margin: 0;
    }

    .security-item p {
      margin-top: 8px;
    }

    @media (min-width: 768px) {
      .security-grid {
        grid-template-columns: repeat(2, 1fr);
        column-gap: 48px;
      }
    }

    @media (min-width: 1100px) {
      .security-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    /* ---------- FAQ ---------- */
    .faq-home {
      display: grid;
      gap: 48px;
    }

    @media (min-width: 1024px) {
      .faq-home {
        grid-template-columns: 5fr 7fr;
        gap: 64px;
      }

      .faq-home-head {
        position: sticky;
        top: calc(var(--header-h) + 32px);
        align-self: start;
      }
    }

    .faq-home-head :global(.link-arrow) {
      margin-top: 32px;
    }
  }
</style>

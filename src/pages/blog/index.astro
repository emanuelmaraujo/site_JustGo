---
/** Blog — layout de revista: artigo em destaque grande + grid editorial. */
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Icon from '@components/Icon.astro';
import PageHero from '@components/site/PageHero.astro';
import CtaFinal from '@components/site/CtaFinal.astro';
import { crumbs } from '@lib/schema';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.data.title.localeCompare(b.data.title),
);

const readingTime = (body: string) => Math.max(2, Math.round(body.split(/\s+/).length / 200));
const fmt = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });

const [featured, ...rest] = posts;
---

<BaseLayout
  title="Blog: mercado autônomo e conveniência em condomínios"
  description="Artigos da Just Go Market para síndicos e moradores: como funciona o mercado autônomo, segurança, assembleia, custos e tendências de conveniência em condomínios."
  schemas={[crumbs(['Blog', '/blog'])]}
>
  <PageHero
    eyebrow="Blog"
    title="Leituras para quem cuida do condomínio."
    lead="Guias práticos sobre mercado autônomo, assembleia, segurança e conveniência — para síndicos, conselhos e moradores."
    crumbs={[{ name: 'Blog', href: '/blog' }]}
  />

  <Section theme="light" tight>
    <div class="container">
      {
        featured && (
          <article class="feat" data-reveal>
            <a href={`/blog/${featured.slug}`} class="feat-link">
              <div class="feat-art" aria-hidden="true">
                <span class="feat-num">01</span>
              </div>
              <div class="feat-copy">
                <p class="post-meta">
                  {featured.data.tags[0] ?? 'Artigo'} · {readingTime(featured.body)} min de leitura
                </p>
                <h2 class="feat-title">{featured.data.title}</h2>
                <p class="feat-desc">{featured.data.description}</p>
                <span class="link-arrow">
                  Ler artigo <Icon name="arrow-right" size={14} />
                </span>
              </div>
            </a>
          </article>
        )
      }

      <ul class="posts">
        {
          rest.map((post, i) => (
            <li data-reveal>
              <a href={`/blog/${post.slug}`} class="post">
                <span class="index-num">{String(i + 2).padStart(2, '0')}</span>
                <p class="post-meta">
                  {post.data.tags[0] ?? 'Artigo'} · {readingTime(post.body)} min
                </p>
                <h2 class="post-title">{post.data.title}</h2>
                <p class="post-desc">{post.data.description}</p>
                <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                  {fmt.format(post.data.pubDate)}
                </time>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <CtaFinal origin="blog_cta" />
</BaseLayout>

<style>
  @layer components {
    .feat-link {
      display: grid;
      gap: 32px;
      padding-bottom: clamp(48px, 6vw, 80px);
      border-bottom: 1px solid var(--line);
    }

    @media (min-width: 1024px) {
      .feat-link {
        grid-template-columns: 5fr 6fr;
        gap: 64px;
        align-items: center;
      }
    }

    .feat-art {
      position: relative;
      aspect-ratio: 4 / 3;
      border-radius: var(--r-media);
      background:
        radial-gradient(90% 70% at 80% 10%, rgba(160, 226, 97, 0.22), transparent 60%),
        linear-gradient(160deg, var(--jg-ink-3), var(--jg-black));
      overflow: hidden;
    }

    .feat-num {
      position: absolute;
      left: 32px;
      bottom: 16px;
      font-family: var(--font-title);
      font-size: clamp(6rem, 14vw, 12rem);
      font-weight: 600;
      line-height: 1;
      letter-spacing: -0.06em;
      color: var(--jg-offwhite);
      opacity: 0.9;
    }

    .post-meta {
      font-family: var(--font-display);
      font-size: var(--fs-label);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--fg-3);
    }

    .feat-title {
      margin-top: 16px;
      font-size: clamp(2rem, 4vw, 3.4rem);
    }

    .feat-desc {
      margin-top: 16px;
      max-width: 52ch;
      font-size: 1.125rem;
    }

    .feat-copy .link-arrow {
      margin-top: 24px;
    }

    .posts {
      display: grid;
      gap: 0 48px;
    }

    @media (min-width: 768px) {
      .posts {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 1100px) {
      .posts {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .post {
      display: grid;
      gap: 12px;
      height: 100%;
      padding: 40px 0;
      border-bottom: 1px solid var(--line);
      align-content: start;
    }

    .post-title {
      font-size: clamp(1.35rem, 2vw, 1.6rem);
      font-weight: 500;
      letter-spacing: -0.025em;
      line-height: 1.2;
      transition: color var(--dur-xs) var(--ease-soft);
    }

    .post-desc {
      font-size: var(--fs-small);
    }

    .post-date {
      font-size: 0.8125rem;
      color: var(--fg-3);
    }

    @media (hover: hover) {
      .feat-link:hover .feat-title,
      .post:hover .post-title {
        text-decoration: underline;
        text-decoration-color: var(--jg-green);
        text-decoration-thickness: 2px;
        text-underline-offset: 6px;
      }
    }
  }
</style>

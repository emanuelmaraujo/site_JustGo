---
/**
 * Artigo — coluna de leitura de 680px, barra de progresso de leitura em verde,
 * índice lateral fixo e CTA contextual ao final.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import SplitWords from '@components/ui/SplitWords.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/Icon.astro';
import CtaFinal from '@components/site/CtaFinal.astro';
import { CTA } from '@lib/site';
import { SITE_URL } from '@lib/seo';
import { crumbs, articleSchema } from '@lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const sorted = posts.sort((a, b) => a.data.title.localeCompare(b.data.title));
  return sorted.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, next: sorted[(i + 1) % sorted.length] },
  }));
}

const { post, next } = Astro.props;
const { Content, headings } = await post.render();
const toc = headings.filter((h) => h.depth === 2);
const minutes = Math.max(2, Math.round(post.body.split(/\s+/).length / 200));
const fmt = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });
const isMorador = post.data.tags.some((t: string) => /morador/i.test(t));
const url = `${SITE_URL}/blog/${post.slug}`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.image}
  schemas={[
    articleSchema({
      title: post.data.title,
      description: post.data.description,
      url,
      datePublished: post.data.pubDate,
      dateModified: post.data.updatedDate,
      image: post.data.image,
      author: post.data.author,
    }),
    crumbs(['Blog', '/blog'], [post.data.title, `/blog/${post.slug}`]),
  ]}
>
  <div class="read-progress" data-scroll-progress="#artigo" data-progress-page aria-hidden="true"></div>

  <Section theme="dark" class="art-hero">
    <div class="container-narrow">
      <nav class="art-crumbs" aria-label="Você está em">
        <a href="/blog"><Icon name="arrow-left" size={14} /> Blog</a>
      </nav>
      <Eyebrow>{post.data.tags[0] ?? 'Artigo'}</Eyebrow>
      <SplitWords tag="h1" immediate class="art-title">{post.data.title}</SplitWords>
      <p class="art-desc">{post.data.description}</p>
      <p class="art-meta">
        <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
        <span aria-hidden="true">·</span>
        {minutes} min de leitura
        <span aria-hidden="true">·</span>
        {post.data.author}
      </p>
    </div>
  </Section>

  <Section theme="light" tight id="artigo">
    <div class="container art-grid">
      {
        toc.length > 1 && (
          <aside class="art-toc" aria-label="Neste artigo">
            <p class="eyebrow eyebrow-plain">Neste artigo</p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
      <article class="prose art-body">
        <Content />
      </article>
    </div>
  </Section>

  <Section theme="paper" tight>
    <div class="container-narrow art-cta">
      {
        isMorador ? (
          <>
            <h2>Quer a Just Go no seu prédio?</h2>
            <p>Faça o diagnóstico em dois minutos e envie o resultado para o seu síndico.</p>
            <Button href="/diagnostico-condominio?perfil=morador" icon="arrow-right" origin="blog_artigo">
              Fazer o diagnóstico
            </Button>
          </>
        ) : (
          <>
            <h2>Avaliando para o seu condomínio?</h2>
            <p>Uma visita técnica responde, no seu espaço, às dúvidas deste artigo. Sem custo e sem compromisso.</p>
            <Button href={CTA.primaryHref} track="cta_agendar_visita" origin="blog_artigo" data-lead-open>
              {CTA.primary}
            </Button>
          </>
        )
      }
      <a href={`/blog/${next.slug}`} class="art-next">
        <span class="eyebrow eyebrow-plain">Próxima leitura</span>
        <span class="art-next-title">{next.data.title}</span>
      </a>
    </div>
  </Section>

  <CtaFinal origin="blog_artigo_cta" />
</BaseLayout>

<style>
  @layer components {
    .read-progress {
      position: fixed;
      inset: 0 0 auto;
      z-index: 120;
      height: 3px;
      background: var(--jg-green);
      transform-origin: left;
      transform: scaleX(var(--progress, 0));
    }

    :global(html:not(.js)) .read-progress {
      display: none;
    }

    .art-hero {
      padding-top: calc(var(--header-h) + clamp(48px, 7vw, 104px));
      padding-bottom: clamp(56px, 7vw, 96px);
    }

    .art-crumbs a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      margin-bottom: 24px;
      font-size: 0.875rem;
      color: var(--fg-2);
    }

    .art-title {
      margin-top: 24px;
      font-size: clamp(2.2rem, 5vw, 4rem);
      line-height: 1.04;
    }

    .art-desc {
      margin-top: 24px;
      font-family: var(--font-display);
      font-size: var(--fs-lead);
      line-height: 1.5;
    }

    .art-meta {
      margin-top: 24px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 0.875rem;
      color: var(--fg-3);
    }

    .art-grid {
      display: grid;
      gap: 40px;
    }

    @media (min-width: 1100px) {
      .art-grid {
        grid-template-columns: 1fr 680px 1fr;
        gap: 56px;
      }

      .art-body {
        grid-column: 2;
      }

      .art-toc {
        grid-column: 1;
        grid-row: 1;
        position: sticky;
        top: calc(var(--header-h) + 40px);
        align-self: start;
      }
    }

    .art-body {
      max-width: 680px;
      width: 100%;
      margin-inline: auto;
    }

    .art-toc ol {
      margin-top: 16px;
      display: grid;
      gap: 4px;
      border-left: 1px solid var(--line);
    }

    .art-toc a {
      display: block;
      padding: 6px 0 6px 16px;
      font-size: 0.875rem;
      line-height: 1.4;
      color: var(--fg-2);
    }

    @media (hover: hover) {
      .art-toc a:hover {
        color: var(--fg);
      }
    }

    @media (max-width: 1099px) {
      .art-toc {
        max-width: 680px;
        width: 100%;
        margin-inline: auto;
        padding: 20px 24px;
        border: 1px solid var(--line);
        border-radius: var(--r-card);
      }
    }

    .art-cta {
      display: grid;
      gap: 16px;
      justify-items: start;
    }

    .art-cta h2 {
      font-size: clamp(1.75rem, 3vw, 2.4rem);
    }

    .art-cta p {
      max-width: 52ch;
      margin-bottom: 8px;
    }

    .art-next {
      margin-top: 40px;
      padding-top: 28px;
      border-top: 1px solid var(--line);
      display: grid;
      gap: 8px;
      width: 100%;
    }

    .art-next-title {
      font-family: var(--font-title);
      font-size: 1.375rem;
      font-weight: 500;
      letter-spacing: -0.02em;
      color: var(--fg);
    }
  }
</style>

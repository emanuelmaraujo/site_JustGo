---
/**
 * Apresentação comercial — Just Go Market.
 * Conteúdo: src/lib/presentation.ts (com a classificação de cada afirmação).
 * Navegação, gestos, tela cheia, analytics e coreografias: src/scripts/deck.ts.
 * Sistema de slides, mobile e impressão: src/styles/deck.css.
 *
 * Abrir um slide específico: /apresentacao#5 (ou #curadoria).
 * Exportar em PDF: imprimir a página (Ctrl/Cmd + P) — 1 slide por página, 16:9.
 */
import DeckLayout from '@layouts/DeckLayout.astro';
import Slide from '@components/deck/Slide.astro';
import JourneyDemo from '@components/deck/JourneyDemo.astro';
import QrCode from '@components/deck/QrCode.astro';
import Photo from '@components/ui/Photo.astro';
import BrandSymbol from '@components/BrandSymbol.astro';
import Icon from '@components/Icon.astro';
import Pattern from '@components/site/Pattern.astro';
import { CTA, FACTS, SITE } from '@lib/site';
import {
  DECK,
  SLIDES,
  MOMENTS,
  SOLUTION,
  CURATION,
  PROJECT_POINTS,
  RESPONSIBILITIES,
  SAFEGUARDS,
  TERMS,
  ROLLOUT_STEPS,
  QUESTIONS,
  deckWhatsappUrl,
} from '@lib/presentation';

const total = String(SLIDES.length).padStart(2, '0');
const phoneHref = `tel:+${SITE.whatsappNumber}`;
---

<DeckLayout
  title="Apresentação comercial | Just Go Market"
  description="Mercado autônomo para condomínios em Brasília: como funciona, o que o condomínio disponibiliza, quem opera e como é a implantação."
>
  <div class="deck" data-deck data-tone="dark">
    <a class="skip-link" href="#convite">Ir para o contato</a>

    <header class="deck-bar">
      <a href="/" class="deck-logo" aria-label="Just Go Market — voltar ao site">
        <img src="/assets/images/logo-negativo.png" alt="" width="640" height="92" class="deck-logo-dark" />
        <img src="/assets/images/logo-positivo.png" alt="" width="640" height="92" class="deck-logo-light" />
      </a>
      <p class="deck-counter" aria-hidden="true">
        <span data-deck-current>01</span><span class="deck-counter-sep">/</span><span>{total}</span>
      </p>
      <div class="deck-tools">
        <button type="button" class="deck-tool" data-deck-fullscreen hidden aria-label="Tela cheia" title="Tela cheia (F)">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <path class="fs-enter" d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path>
            <path class="fs-exit" d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5"></path>
          </svg>
        </button>
        <a href="/" class="deck-tool deck-tool-text">Site</a>
      </div>
    </header>

    <main id="conteudo" class="deck-slides" aria-label="Apresentação comercial da Just Go Market" tabindex="-1">
      <!-- 01 — Abertura -->
      <Slide id="abertura" theme="dark" class="s-open">
        <Pattern id="deck-pattern-open" opacity={0.04} size={180} drift={false} />
        <div class="open-grid">
          <div class="open-copy">
            <p class="eyebrow" data-a>Mercado autônomo para condomínios · Brasília</p>
            <h1 class="deck-h1" data-a>O essencial, <span class="hl">a um passo</span> de casa.</h1>
            <p class="deck-lead" data-a>
              Um mercado de autoatendimento, aberto 24 horas, dentro do condomínio. A Just Go Market investe, instala e
              opera. O condomínio cede o espaço.
            </p>
            <ul class="open-facts" data-a>
              <li><strong>≈{FACTS.area}</strong> de área comum</li>
              <li><strong>1</strong> ponto de energia</li>
              <li><strong>{FACTS.investment}</strong> de investimento do condomínio</li>
            </ul>
          </div>
          <div class="open-mark" aria-hidden="true">
            <BrandSymbol class="open-symbol" />
          </div>
        </div>
        <p class="deck-hint" data-a aria-hidden="true">
          <span class="hint-keys">← →</span> ou deslize para navegar
        </p>
      </Slide>

      <!-- 02 — A oportunidade -->
      <Slide id="oportunidade" theme="paper">
        <div class="opp-grid">
          <div>
            <h2 class="deck-h2" data-a>Um item que falta costuma custar uma saída inteira.</h2>
            <p class="deck-lead" data-a>
              Carro, trânsito, estacionamento ou a espera de uma entrega. Com um mercado no térreo, essas pequenas faltas
              se resolvem <span class="hl">a um elevador de distância.</span>
            </p>
          </div>
          <ol class="moments">
            {
              MOMENTS.map((m) => (
                <li class="moment" data-a-moment>
                  <span class="moment-time">{m.time}</span>
                  <span class="moment-text">{m.text}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </Slide>

      <!-- 03 — A solução -->
      <Slide id="solucao" theme="dark">
        <div class="sol-grid">
          <div>
            <h2 class="deck-h2" data-a>Uma loja de autoatendimento, dentro do condomínio.</h2>
            <p class="deck-lead" data-a>
              Prateleiras, geladeiras e um totem de pagamento em uma área comum. Sem caixa e sem funcionários do
              condomínio.
            </p>
          </div>
          <div class="sol-plan" aria-hidden="true">
            <svg viewBox="0 0 520 340" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <g class="plan-walls">
                <path d="M20 20h480v300H20z" pathLength="1" />
                <path d="M20 140h140M300 20v120M300 200v120M160 140v60" pathLength="1" />
              </g>
              <g class="plan-labels">
                <text x="90" y="85">Hall</text>
                <text x="400" y="85">Salão</text>
                <text x="90" y="265">Acesso</text>
              </g>
              <g class="plan-store">
                <rect x="320" y="210" width="160" height="94" rx="8" pathLength="1" />
                <path d="M336 228v58M356 228v58M460 228v42" />
                <rect x="400" y="276" width="30" height="16" rx="3" />
              </g>
              <text x="400" y="200" text-anchor="middle" class="plan-tag">≈{FACTS.area}</text>
            </svg>
          </div>
        </div>
        <ol class="pillars">
          {
            SOLUTION.map((s, i) => (
              <li class="pillar" data-a-pillar>
                <span class="pillar-n">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="pillar-k">{s.k}</h3>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ol>
      </Slide>

      <!-- 04 — Jornada de compra -->
      <Slide id="jornada" theme="ink">
        <JourneyDemo>
          <div class="slide-head">
            <h2 class="deck-h2" data-a>Entrar, escolher, ler o código e pagar.</h2>
            <p class="deck-lead" data-a>Sem fila e sem caixa. O pagamento é feito por Pix, no próprio totem.</p>
          </div>
        </JourneyDemo>
      </Slide>

      <!-- 05 — Curadoria -->
      <Slide id="curadoria" theme="dark" layout="top" class="s-cur">
        <div class="slide-head split-head">
          <h2 class="deck-h2" data-a>Uma seleção para o dia a dia de quem mora ali.</h2>
          <p class="deck-lead" data-a>O mix é definido para cada condomínio e ajustado ao que os moradores compram.</p>
        </div>
        <ul class="cur-grid">
          {
            CURATION.map((c) => (
              <li class="cur-item" data-a-tile>
                <Photo name={c.photo} alt={c.alt} ratio="4/5" sizes="(min-width: 1024px) 22vw, 45vw" class="cur-photo" />
                <h3 class="cur-title">{c.title}</h3>
                <p class="cur-text">{c.text}</p>
              </li>
            ))
          }
        </ul>
        <p class="deck-foot" data-a>
          Fotografias editoriais de produtos (banco de imagens licenciado). Não representam o sortimento de uma loja
          específica.
        </p>
      </Slide>

      <!-- 06 — Integração ao espaço -->
      <Slide id="projeto" theme="light" layout="top">
        <div class="proj-grid">
          <div class="proj-copy">
            <h2 class="deck-h2" data-a>Um projeto para cada espaço.</h2>
            <ul class="list-check proj-list">
              {PROJECT_POINTS.map((p) => <li data-a>{p}</li>)}
            </ul>
          </div>
          <div class="proj-media">
            <div class="proj-main" data-a-render>
              <Photo
                name="conceito-fachada"
                alt="Projeto conceitual em 3D da fachada de uma loja Just Go, com vitrine e a marca iluminada"
                ratio="16/9"
                sizes="(min-width: 1024px) 55vw, 100vw"
                kind="concept"
              />
            </div>
            <div class="proj-thumbs">
              <div data-a-render>
                <Photo
                  name="conceito-interior"
                  alt="Projeto conceitual do interior: geladeiras à esquerda e gôndola central"
                  ratio="16/9"
                  sizes="(min-width: 1024px) 27vw, 50vw"
                  kind="concept"
                />
              </div>
              <div data-a-render>
                <Photo
                  name="conceito-totem"
                  alt="Projeto conceitual do balcão de autoatendimento com dois totens"
                  ratio="16/9"
                  sizes="(min-width: 1024px) 27vw, 50vw"
                  kind="concept"
                />
              </div>
            </div>
            <p class="deck-foot" data-a>
              Renders conceituais. Não representam uma loja instalada; produtos e embalagens são ilustrativos.
            </p>
          </div>
        </div>
      </Slide>

      <!-- 07 — Modelo operacional -->
      <Slide id="modelo" theme="paper">
        <div class="slide-head">
          <h2 class="deck-h2" data-a>Quem faz o quê.</h2>
          <p class="deck-lead" data-a>A operação fica com a Just Go Market. O condomínio participa nas decisões.</p>
        </div>
        <div class="resp">
          <div class="resp-col resp-jg">
            <h3 class="resp-title">
              <span class="resp-dot" aria-hidden="true"></span>Just Go Market
            </h3>
            <ul>{RESPONSIBILITIES.justgo.map((r) => <li data-a-left>{r}</li>)}</ul>
          </div>
          <div class="resp-axis" aria-hidden="true"></div>
          <div class="resp-col resp-condo">
            <h3 class="resp-title">
              <span class="resp-dot resp-dot-outline" aria-hidden="true"></span>Condomínio
            </h3>
            <ul>{RESPONSIBILITIES.condo.map((r) => <li data-a-right>{r}</li>)}</ul>
          </div>
        </div>
      </Slide>

      <!-- 08 — Segurança e suporte -->
      <Slide id="seguranca" theme="dark">
        <div class="slide-head split-head">
          <h2 class="deck-h2" data-a>Controle e suporte desde o primeiro dia.</h2>
          <p class="deck-lead" data-a>
            Nenhum sistema elimina todos os riscos. Por isso a responsabilidade é clara: a operação da loja é da Just Go
            Market, não da administração.
          </p>
        </div>
        <ul class="safe-list">
          {
            SAFEGUARDS.map((s) => (
              <li class="safe-item" data-a-safe>
                <span class="safe-icon">
                  <Icon name={s.icon} size={22} />
                </span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ul>
        <p class="deck-foot" data-a>Recursos descritos conforme o projeto de operação. A configuração de cada loja consta da proposta.</p>
      </Slide>

      <!-- 09 — Condições comerciais -->
      <Slide id="condicoes" theme="green">
        <div class="slide-head">
          <h2 class="deck-h2" data-a>O que o condomínio precisa oferecer.</h2>
        </div>
        <dl class="terms">
          {
            TERMS.map((t) => (
              <div class="term" data-a-term>
                <dt class="term-label">{t.label}</dt>
                <dd class="term-value">
                  {t.value}
                  {t.unit && <span class="term-unit">{t.unit}</span>}
                </dd>
                <dd class="term-note">{t.note}</dd>
              </div>
            ))
          }
        </dl>
        <p class="deck-foot" data-a>Condições de referência. Os termos definitivos constam da proposta e do contrato.</p>
      </Slide>

      <!-- 10 — Implantação -->
      <Slide id="implantacao" theme="dark">
        <div class="slide-head">
          <h2 class="deck-h2" data-a>Do primeiro contato à inauguração.</h2>
          <p class="deck-lead" data-a>A Just Go Market conduz cada etapa. O condomínio aprova.</p>
        </div>
        <ol class="road">
          <span class="road-line" aria-hidden="true"><span class="road-fill"></span></span>
          {
            ROLLOUT_STEPS.map((s, i) => (
              <li class="road-step" data-a-road>
                <span class="road-node" aria-hidden="true" />
                <span class="road-n">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="road-title">{s.title}</h3>
                <p class="road-meta">{s.meta}</p>
              </li>
            ))
          }
        </ol>
        <p class="deck-foot" data-a>Prazos estimados, não garantidos. O cronograma de cada condomínio é definido na proposta.</p>
      </Slide>

      <!-- 11 — Perguntas importantes -->
      <Slide id="perguntas" theme="light" layout="top">
        <div class="slide-head">
          <h2 class="deck-h2" data-a>Perguntas que todo síndico faz.</h2>
        </div>
        <dl class="qa">
          {
            QUESTIONS.map((x) => (
              <div class="qa-item" data-a-qa>
                <dt>{x.q}</dt>
                <dd>{x.a}</dd>
              </div>
            ))
          }
        </dl>
      </Slide>

      <!-- 12 — Próximo passo -->
      <Slide id="convite" theme="dark" class="s-close">
        <Pattern id="deck-pattern-close" opacity={0.04} size={180} drift={false} />
        <div class="close-grid">
          <div class="close-copy">
            <h2 class="deck-h1 close-title" data-a>Vamos avaliar o espaço do seu condomínio?</h2>
            <p class="deck-lead" data-a>
              Uma visita técnica mostra, no local, o que cabe, onde e como. Depois, você recebe a proposta para levar à
              assembleia.
            </p>
            <div class="btn-row close-ctas" data-a>
              <a href={CTA.primaryHref} class="btn btn-primary" data-deck-cta="agendar_visita">
                <span class="btn-label">{CTA.primary}</span>
                <span class="btn-icon" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
              </a>
              <a
                href={deckWhatsappUrl()}
                class="btn btn-secondary"
                target="_blank"
                rel="noopener noreferrer"
                data-deck-cta="whatsapp"
              >
                <span class="btn-label">{CTA.secondary}</span>
                <span class="btn-icon" aria-hidden="true"><Icon name="whatsapp" size={16} /></span>
                <span class="sr-only">(abre em nova aba)</span>
              </a>
            </div>
            <ul class="close-contacts" data-a>
              <li>
                <Icon name="phone" size={16} />
                <a href={phoneHref} data-deck-cta="telefone">{SITE.whatsappDisplay}</a>
              </li>
              <li>
                <Icon name="mail" size={16} />
                <a href={`mailto:${SITE.email}`} data-deck-cta="email">{SITE.email}</a>
              </li>
              <li>
                <Icon name="pin" size={16} />
                <a href="/" data-deck-cta="site">justgomarket.com.br</a>
              </li>
            </ul>
          </div>
          <figure class="close-qr" data-a-qr>
            <a href={DECK.qrUrl} class="close-qr-link" data-deck-cta="qrcode_link">
              <QrCode value={DECK.qrUrl} label="QR Code para a página de agendamento de visita da Just Go Market" />
            </a>
            <figcaption>
              <strong>Aponte a câmera</strong>
              <span>e agende a visita técnica</span>
            </figcaption>
          </figure>
        </div>
      </Slide>
    </main>

    <nav class="deck-nav" aria-label="Navegação da apresentação">
      <div class="deck-progress" aria-hidden="true"><span class="deck-progress-bar" data-deck-progress></span></div>
      <button type="button" class="deck-arrow" data-deck-prev aria-label="Slide anterior">
        <Icon name="arrow-left" size={18} />
      </button>
      <p class="deck-label" data-deck-label aria-hidden="true">Abertura</p>
      <button type="button" class="deck-arrow" data-deck-next aria-label="Próximo slide">
        <Icon name="arrow-right" size={18} />
      </button>
    </nav>
    <p class="sr-only" aria-live="polite" data-deck-live></p>
  </div>
</DeckLayout>

<style>
  @layer components {
    /* ---------- 01 Abertura ---------- */
    .s-open .slide-inner,
    .s-close .slide-inner {
      position: relative;
      z-index: 1;
    }

    .open-grid {
      display: grid;
      gap: clamp(24px, 4vw, 64px);
      align-items: center;
    }

    @media (min-width: 900px) {
      .open-grid {
        grid-template-columns: 1.35fr 0.65fr;
      }
    }

    .open-copy > * + * {
      margin-top: clamp(16px, 3svh, 32px);
    }

    .open-facts {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 28px;
      padding-top: clamp(16px, 2.6svh, 28px);
      border-top: 1px solid var(--line);
      font-family: var(--font-display);
      font-size: var(--deck-small);
      color: var(--fg-2);
    }

    .open-facts strong {
      font-family: var(--font-title);
      font-weight: 500;
      color: var(--fg);
      margin-right: 4px;
    }

    .open-mark {
      display: grid;
      place-items: center;
    }

    .open-mark :global(.open-symbol) {
      width: min(100%, 38svh, 360px);
    }

    @media (max-width: 899px) {
      .open-mark {
        order: -1;
        justify-items: start;
      }

      .open-mark :global(.open-symbol) {
        width: 72px;
      }
    }

    /* ---------- 02 Oportunidade ---------- */
    .opp-grid {
      display: grid;
      gap: clamp(28px, 5vw, 80px);
      align-items: center;
    }

    @media (min-width: 900px) {
      .opp-grid {
        grid-template-columns: 1.1fr 0.9fr;
      }
    }

    .opp-grid .deck-lead {
      margin-top: clamp(16px, 3svh, 32px);
    }

    .moments {
      display: grid;
      border-top: 1px solid var(--line);
    }

    .moment {
      display: grid;
      grid-template-columns: 5.2em 1fr;
      gap: 16px;
      align-items: baseline;
      padding: clamp(14px, 2.4svh, 26px) 0;
      border-bottom: 1px solid var(--line);
    }

    .moment-time {
      font-family: var(--font-title);
      font-size: var(--deck-h3);
      font-weight: 500;
      letter-spacing: -0.02em;
      font-variant-numeric: tabular-nums;
      color: var(--fg);
    }

    .moment-text {
      font-size: var(--deck-body);
      color: var(--fg-2);
    }

    /* ---------- 03 Solução ---------- */
    .sol-grid {
      display: grid;
      gap: clamp(24px, 4vw, 64px);
      align-items: center;
    }

    @media (min-width: 900px) {
      .sol-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    .sol-grid .deck-lead {
      margin-top: clamp(16px, 3svh, 28px);
    }

    .sol-plan svg {
      width: 100%;
      max-height: 34svh;
    }

    .plan-walls {
      stroke: rgba(255, 253, 252, 0.4);
      stroke-width: 1.5;
    }

    .plan-labels text {
      fill: var(--fg-3);
      font-family: var(--font-display);
      font-size: 14px;
      letter-spacing: 0.06em;
      text-anchor: middle;
    }

    .plan-store {
      stroke: var(--jg-green);
      stroke-width: 2;
      fill: rgba(160, 226, 97, 0.08);
    }

    .plan-tag {
      fill: var(--jg-green);
      font-family: var(--font-title);
      font-size: 18px;
    }

    .pillars {
      margin-top: clamp(24px, 5svh, 56px);
      display: grid;
      gap: 0;
      border-top: 1px solid var(--line);
    }

    @media (min-width: 900px) {
      .pillars {
        grid-template-columns: repeat(3, 1fr);
        column-gap: clamp(24px, 3vw, 48px);
      }
    }

    .pillar {
      padding: clamp(14px, 2.6svh, 28px) 0;
      border-bottom: 1px solid var(--line);
    }

    @media (min-width: 900px) {
      .pillar {
        border-bottom: 0;
      }
    }

    .pillar-n {
      font-family: var(--font-title);
      font-size: 0.875rem;
      color: var(--jg-green);
    }

    .pillar-k {
      margin-top: 8px;
      font-size: var(--deck-h3);
    }

    .pillar p {
      margin-top: 8px;
      font-size: var(--deck-body);
    }

    /* ---------- 05 Curadoria ---------- */
    .cur-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(16px, 2vw, 28px);
    }

    @media (min-width: 1024px) {
      .cur-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    .cur-item :global(.cur-photo) {
      border-radius: var(--r-card);
    }

    @media (min-width: 1024px) and (min-aspect-ratio: 4/3) {
      .cur-item :global(.cur-photo) {
        aspect-ratio: auto;
        height: 30svh;
      }
    }

    .s-cur :global(.deck-h2) {
      max-width: 22ch;
    }

    .cur-title {
      margin-top: 14px;
      font-size: var(--deck-h3);
    }

    .cur-text {
      margin-top: 4px;
      font-size: var(--deck-small);
    }

    /* ---------- 06 Projeto ---------- */
    .proj-grid {
      display: grid;
      gap: clamp(24px, 4vw, 56px);
      align-items: center;
    }

    @media (min-width: 1024px) {
      .proj-grid {
        grid-template-columns: 0.8fr 1.2fr;
      }
    }

    .proj-list {
      margin-top: clamp(20px, 3.4svh, 36px);
      font-size: var(--deck-body);
    }

    .proj-list :global(li) {
      color: var(--fg-2);
    }

    .proj-media {
      display: grid;
      gap: 12px;
    }

    .proj-main :global(.photo),
    .proj-thumbs :global(.photo) {
      border-radius: var(--r-card);
    }

    @media (min-width: 1024px) and (min-aspect-ratio: 4/3) {
      .proj-main :global(.photo) {

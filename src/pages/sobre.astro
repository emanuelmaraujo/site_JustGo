---
/**
 * Sobre / Manifesto — origem brasiliense, diferenciais e valores
 * (lista tipográfica com revelação sequencial).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import SplitWords from '@components/ui/SplitWords.astro';
import WordLight from '@components/ui/WordLight.astro';
import Photo from '@components/ui/Photo.astro';
import PageHero from '@components/site/PageHero.astro';
import CtaFinal from '@components/site/CtaFinal.astro';
import { SITE } from '@lib/site';
import { crumbs } from '@lib/schema';

const manifesto =
  'Acreditamos que o tempo é o bem mais valioso que existe. Que conveniência não deveria exigir pegar o carro, enfrentar fila ou baixar mais um aplicativo. Que o vinho do jantar, o café especial e o leite da manhã podem estar no mesmo lugar — a um passo de casa. Por isso existimos: para antecipar o que você precisa, com curadoria, discrição e cuidado. E devolver o seu tempo para o que importa.';

const pillars = [
  {
    title: 'Projeto integrado',
    text: 'Cada loja é desenhada para o prédio onde vai morar, com materiais e acabamentos que respeitam a arquitetura.',
  },
  {
    title: 'Curadoria',
    text: 'Do essencial de emergência ao vinho do fim de semana, com um mix ajustado ao que cada condomínio pede.',
  },
  {
    title: 'Operação invisível',
    text: 'Reposição, limpeza, manutenção e segurança acontecem nos bastidores. O condomínio só percebe a conveniência.',
  },
];

const differences = [
  'Estética de alto padrão, não de franquia',
  'Curadoria de empório, não só o básico',
  'Projeto desenhado para cada condomínio',
  'Relação direta com o condomínio, sem franqueados',
  'Compra sem aplicativo, com Pix ou cartão',
  'Empresa de Brasília, com operação local',
];

const values = [
  { title: 'Foco no cliente', text: 'Antecipar necessidades antes de elas virarem problema.' },
  { title: 'Qualidade inegociável', text: 'No produto, no projeto e no atendimento.' },
  { title: 'Integridade e transparência', text: 'Afirmamos só o que podemos cumprir — e cumprimos.' },
  { title: 'Conexão com a comunidade', text: 'Cada loja é parte da rotina de um prédio e das pessoas que moram nele.' },
  { title: 'Inovação contínua', text: 'Tecnologia a serviço da simplicidade, sempre um passo à frente.' },
];
---

<BaseLayout
  title="Sobre a Just Go Market"
  description="Nascemos em Brasília da convicção de que o tempo é o novo luxo. Conheça o manifesto, os pilares e os valores da Just Go Market, mercado autônomo de alto padrão para condomínios."
  schemas={[crumbs(['Sobre', '/sobre'])]}
>
  <PageHero
    eyebrow="Sobre"
    title="Nascemos da convicção de que o <span class='hl'>tempo</span> é o novo luxo."
    lead="A Just Go Market é uma empresa de Brasília que leva conveniência de alto padrão para dentro dos condomínios — com projeto, curadoria e operação próprios."
    crumbs={[{ name: 'Sobre', href: '/sobre' }]}
  />

  <Section theme="light" class="manifesto-page">
    <div class="container">
      <Eyebrow>Manifesto</Eyebrow>
      <WordLight tag="blockquote" class="statement manifesto-full" text={manifesto} highlight={['tempo', 'importa.']} />
      <p class="manifesto-sign">{SITE.slogan}</p>
    </div>
  </Section>

  <Section theme="dark">
    <div class="container split">
      <Photo name="brasilia-noite" alt="Brasília à noite, com o trânsito iluminado sob um viaduto e prédios ao fundo" ratio="4/5" unveil parallax position="60% center" />
      <div class="split-copy">
        <Eyebrow>Nossa origem</Eyebrow>
        <SplitWords tag="h2">Feita em Brasília, para Brasília.</SplitWords>
        <p data-reveal>
          Uma cidade monumental, onde as distâncias roubam tempo precioso. Em condomínios de alto padrão, a casa é um
          refúgio — e a conveniência não deveria exigir sair dele.
        </p>
        <p data-reveal>
          Desenhamos a Just Go Market como uma extensão do lar: discreta, bem resolvida, à altura da arquitetura dos
          prédios mais exigentes do DF. Uma cidade planejada para o futuro merecia uma conveniência à sua altura.
        </p>
      </div>
    </div>
  </Section>

  <Section theme="ink">
    <div class="container">
      <div class="section-head">
        <Eyebrow>Pilares</Eyebrow>
        <SplitWords tag="h2" class="mt-m">Três coisas que fazemos com rigor.</SplitWords>
      </div>
      <ol class="grid-3 pillars">
        {
          pillars.map((p, i) => (
            <li data-reveal>
              <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <Section theme="paper">
    <div class="container split top">
      <div class="split-copy">
        <Eyebrow>O que nos diferencia</Eyebrow>
        <SplitWords tag="h2">Conveniência com cara de casa, não de franquia.</SplitWords>
      </div>
      <ul class="list-check diff" data-reveal>
        {differences.map((d) => <li>{d}</li>)}
      </ul>
    </div>
  </Section>

  <Section theme="dark">
    <div class="container">
      <Eyebrow>Valores</Eyebrow>
      <ol class="values">
        {
          values.map((v, i) => (
            <li data-reveal>
              <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="values-title">
                <span class="sw"><span style="--i:0">{v.title}</span></span>
              </h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <CtaFinal title="Vamos conversar sobre o seu condomínio?" origin="sobre_cta" />
</BaseLayout>

<style>
  @layer components {
    .manifesto-full {
      margin-top: 40px;
      max-width: 28ch;
    }

    .manifesto-sign {
      margin-top: 48px;
      font-family: var(--font-display);
    }

    .pillars {
      display: grid;
      gap: 40px 24px;
    }

    .pillars h3 {
      margin-top: 16px;
    }

    .pillars p {
      margin-top: 10px;
    }

    .split.top {
      align-items: start;
    }

    .diff {
      gap: 20px;
      font-size: 1.125rem;
    }

    .values {
      margin-top: 40px;
      border-top: 1px solid var(--line);
    }

    .values li {
      display: grid;
      gap: 8px;
      padding: clamp(24px, 3vw, 40px) 0;
      border-bottom: 1px solid var(--line);
      align-items: baseline;
    }

    @media (min-width: 900px) {
      .values li {
        grid-template-columns: 80px 1.3fr 1fr;
        gap: 32px;
      }
    }

    .values-title {
      font-size: clamp(1.9rem, 4.2vw, 3.6rem);
      font-weight: 600;
      letter-spacing: var(--tracking-h2);
      line-height: 1.05;
    }

    :global(.motion) .values li .sw > span {
      transform: translate3d(0, 110%, 0);
      transition: transform var(--dur-l) var(--ease-out-expo) var(--d, 0s);
    }

    :global(.motion) .values li.is-in .sw > span {
      transform: none;
    }
  }
</style>

---
/** FAQ — abas Síndico/Morador. Conteúdo em src/content/faq. */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Button from '@components/ui/Button.astro';
import PageHero from '@components/site/PageHero.astro';
import FaqTabs from '@components/site/FaqTabs.astro';
import CtaFinal from '@components/site/CtaFinal.astro';
import { getFaqs } from '@lib/content';
import { whatsappUrl } from '@lib/site';
import { crumbs, faqPageSchema } from '@lib/schema';

const faqs = await getFaqs();
---

<BaseLayout
  title="Perguntas frequentes sobre o mercado autônomo no condomínio"
  description="Custos, espaço, segurança, energia, contrato, formas de pagamento e como comprar: as respostas para síndicos e moradores sobre a Just Go Market."
  schemas={[faqPageSchema(faqs.all), crumbs(['Perguntas frequentes', '/faq'])]}
>
  <PageHero
    eyebrow="Perguntas frequentes"
    title="Respostas diretas, para síndicos e moradores."
    lead="As dúvidas que mais ouvimos — do custo para o condomínio à forma de pagamento no totem."
    crumbs={[{ name: 'Perguntas frequentes', href: '/faq' }]}
  />

  <Section theme="light" tight>
    <div class="container-narrow">
      <FaqTabs id="faq-page" sindico={faqs.sindico} morador={faqs.morador} level={2} />
      <div class="faq-more" data-reveal>
        <p>Não encontrou o que procurava?</p>
        <Button
          href={whatsappUrl('Olá! Tenho uma dúvida sobre a Just Go Market.')}
          variant="secondary"
          icon="whatsapp"
          external
          origin="faq_duvida"
        >
          Perguntar no WhatsApp
        </Button>
      </div>
    </div>
  </Section>

  <CtaFinal origin="faq_cta" />
</BaseLayout>

<style>
  @layer components {
    .faq-more {
      margin-top: 64px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 16px 32px;
      padding: 28px 32px;
      border: 1px solid var(--line);
      border-radius: var(--r-card);
    }

    .faq-more p {
      font-family: var(--font-display);
      font-size: 1.25rem;
      color: var(--fg);
    }
  }
</style>

---
/**
 * Curadoria — galeria editorial por categoria. Não é e-commerce:
 * mostra o tipo de produto e o padrão, sem preços.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import SplitWords from '@components/ui/SplitWords.astro';
import Photo from '@components/ui/Photo.astro';
import Button from '@components/ui/Button.astro';
import PageHero from '@components/site/PageHero.astro';
import CtaFinal from '@components/site/CtaFinal.astro';
import BrandWall from '@components/ui/BrandWall.astro';
import { getCuradoria } from '@lib/content';
import { whatsappUrl } from '@lib/site';
import { SERVICES } from '@lib/services';
import { crumbs } from '@lib/schema';

const universes = await getCuradoria();
---

<BaseLayout
  title="Curadoria: adega, empório e despensa 24h no condomínio"
  description="Vinhos selecionados, chocolates, queijos, azeites e o essencial do dia a dia, 24 horas, no térreo do seu condomínio em Brasília. Conheça a curadoria da Just Go Market."
  schemas={[crumbs(['Curadoria', '/curadoria'])]}
>
  <PageHero
    eyebrow="Curadoria"
    title="O essencial, a um passo. E o <span class='hl'>especial</span> também."
    lead="Cada loja recebe uma seleção pensada para quem mora ali — da adega ao café da manhã — e ajustada ao que os moradores pedem."
    crumbs={[{ name: 'Curadoria', href: '/curadoria' }]}
  />

  <div data-track-view="curadoria_view">
    {
      universes.map((u, i) => (
        <Section theme={i % 2 === 0 ? 'dark' : 'ink'} id={u.photo.name.replace('curadoria-', '')} tight={i > 0}>
          <div class:list={['container split', i % 2 === 1 && 'reverse']}>
            <Photo {...u.photo} ratio="4/5" unveil parallax sizes="(min-width: 1024px) 50vw, 100vw" />
            <div class="split-copy">
              <p class="index-num">
                {String(i + 1).padStart(2, '0')}/{String(universes.length).padStart(2, '0')}
              </p>
              <Eyebrow>{u.kicker}</Eyebrow>
              <SplitWords tag="h2">{u.title}</SplitWords>
              <p class="lead" data-reveal>
                {u.long}
              </p>
              <ul class="list-check" data-reveal>
                {u.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </Section>
      ))
    }
  </div>

  <!-- Marcas de referência -->
  <Section theme="dark" id="marcas">
    <div class="container">
      <div class="section-head split">
        <div>
          <Eyebrow>Marcas de referência</Eyebrow>
          <SplitWords tag="h2" class="mt-m">Marcas que você já escolhe em casa.</SplitWords>
        </div>
        <p class="lead" data-reveal>
          O padrão da curadoria: rótulos e fabricantes reconhecidos em cada categoria, do espumante ao café da manhã.
        </p>
      </div>
      <div data-reveal>
        <BrandWall />
      </div>
    </div>
  </Section>

  <!-- Serviços exclusivos -->
  <Section theme="paper" id="servicos">
    <div class="container">
      <div class="section-head split">
        <div>
          <Eyebrow>Serviços exclusivos</Eyebrow>
          <SplitWords tag="h2" class="mt-m">Além da prateleira.</SplitWords>
        </div>
        <p class="lead" data-reveal>
          O que diferencia uma loja de conveniência de uma experiência pensada para o condomínio.
        </p>
      </div>
      <ol class="svc">
        {
          SERVICES.map((s, i) => (
            <li class="svc-item" data-reveal>
              <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <Section theme="light">
    <div class="container split">
      <div class="split-copy">
        <Eyebrow>Mix sob medida</Eyebrow>
        <SplitWords tag="h2">Cada prédio tem o seu mix.</SplitWords>
        <p class="lead" data-reveal>
          Acompanhamos o que sai e o que falta. Itens procurados ganham espaço; o que não gira dá lugar a novidades.
          Moradores sugerem produtos pelo WhatsApp e a gente avalia toda semana.
        </p>
        <div data-reveal>
          <Button
            href={whatsappUrl('Olá! Quero sugerir um produto para a Just Go do meu condomínio.')}
            variant="secondary"
            icon="whatsapp"
            external
            origin="curadoria_sugestao"
          >
            Sugerir um produto
          </Button>
        </div>
      </div>
      <div class="mix-note" data-reveal>
        <img
          src="/assets/brand/selo-tempo-preto.svg"
          alt="Selo Just Go Market: A gente devolve o seu tempo"
          width="320"
          height="320"
          loading="lazy"
          class="mix-seal"
        />
      </div>
    </div>
  </Section>

  <CtaFinal title="Quer essa curadoria no seu condomínio?" origin="curadoria_cta" />
</BaseLayout>

<style>
  @layer components {
    .mix-note {
      align-self: center;
      justify-self: center;
    }

    .mix-seal {
      width: clamp(180px, 22vw, 300px);
      height: auto;
    }

    .svc {
      display: grid;
      gap: 0;
      border-top: 1px solid var(--line);
    }

    .svc-item {
      padding: 32px 0;
      border-bottom: 1px solid var(--line);
    }

    .svc-item h3 {
      margin-top: 12px;
    }

    .svc-item p {
      margin-top: 10px;
      max-width: 38ch;
    }

    @media (min-width: 900px) {
      .svc {
        grid-template-columns: repeat(3, 1fr);
        column-gap: 48px;
      }

      .svc-item {
        border-bottom: 0;
      }
    }
  }
</style>

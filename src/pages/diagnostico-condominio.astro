---
/** Diagnóstico de viabilidade (wizard). Modo morador: ?perfil=morador */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import SplitWords from '@components/ui/SplitWords.astro';
import Diagnostic from '@components/site/Diagnostic.astro';
import { crumbs } from '@lib/schema';
---

<BaseLayout
  title="Diagnóstico de viabilidade do condomínio"
  description="Descubra em dois minutos se o seu condomínio em Brasília tem perfil para um mercado autônomo Just Go Market. Diagnóstico gratuito, com resultado na hora."
  schemas={[crumbs(['Diagnóstico', '/diagnostico-condominio'])]}
>
  <Section theme="dark" class="dgp">
    <div class="container dgp-grid">
      <div class="dgp-intro">
        <Eyebrow>Diagnóstico gratuito</Eyebrow>
        <SplitWords tag="h1" immediate class="dgp-title">Dois minutos para saber.</SplitWords>
        <p class="lead dgp-lead">
          Uma avaliação rápida sobre estrutura, moradores e entorno. Ao final, você recebe a pontuação e pode enviar o
          resultado para o nosso time — ou para o seu síndico.
        </p>
      </div>
      <Diagnostic />
    </div>
  </Section>
</BaseLayout>

<style>
  @layer components {
    .dgp {
      padding-top: calc(var(--header-h) + clamp(56px, 8vw, 112px));
    }

    .dgp-grid {
      display: grid;
      gap: 48px;
    }

    @media (min-width: 1100px) {
      .dgp-grid {
        grid-template-columns: 4fr 7fr;
        gap: 80px;
        align-items: start;
      }

      .dgp-intro {
        position: sticky;
        top: calc(var(--header-h) + 48px);
      }
    }

    .dgp-title {
      margin-top: 28px;
      font-size: clamp(2.6rem, 5.4vw, 5rem);
      max-width: 10ch;
    }

    .dgp-lead {
      margin-top: 28px;
    }
  }
</style>

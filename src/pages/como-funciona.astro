---
/**
 * Como funciona — fusão de /como-funciona e /como-funciona-na-pratica (301).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import SplitWords from '@components/ui/SplitWords.astro';
import StickySteps from '@components/ui/StickySteps.astro';
import Icon from '@components/Icon.astro';
import PageHero from '@components/site/PageHero.astro';
import CtaFinal from '@components/site/CtaFinal.astro';
import { BUY_STEPS, ROLLOUT, OPERATION, WE_DO, CONDO_GIVES } from '@lib/model';
import { FACTS } from '@lib/site';
import { crumbs, serviceSchema } from '@lib/schema';

const tech = [
  { title: 'Totem Scan & Go', text: 'Leitor de código de barras e tela de pagamento com Pix e cartão.' },
  { title: 'Inventário inteligente', text: 'Estoque acompanhado em tempo real, com alertas automáticos de reposição.' },
  { title: 'Câmeras em nuvem', text: 'Monitoramento 24h com acesso remoto da nossa equipe.' },
  { title: 'Aplicativo do condomínio', text: 'Acesso controlado e verificação de maioridade, quando o condomínio escolhe.' },
];
---

<BaseLayout
  title="Como funciona o mercado autônomo no condomínio"
  description="Do primeiro contato à loja aberta 24 horas: como funciona a implantação e a operação do mercado autônomo Just Go Market em condomínios de Brasília, sem custo para o condomínio."
  schemas={[serviceSchema(), crumbs(['Como funciona', '/como-funciona'])]}
>
  <PageHero
    eyebrow="Como funciona"
    title="Do primeiro contato à loja aberta 24 horas."
    lead={`Uma implantação de ${FACTS.totalDays}, conduzida do início ao fim por nós. Depois, uma operação que o condomínio não precisa acompanhar.`}
    crumbs={[{ name: 'Como funciona', href: '/como-funciona' }]}
    photo={{
      name: 'projeto-interior',
      alt: 'Interior de uma loja Just Go: prateleiras de madeira, geladeiras e totem de autoatendimento',
      placeholder: 'Projeto 3D — interior da loja (render do projeto)',
      illustrative: true,
    }}
  />

  <Section theme="light">
    <div class="container split">
      <div class="split-copy">
        <Eyebrow>O conceito</Eyebrow>
        <SplitWords tag="h2">O que é um mercado autônomo para condomínios?</SplitWords>
      </div>
      <div class="prose" data-reveal>
        <p>
          Um mercado autônomo é uma loja de conveniência sem funcionários fixos, instalada dentro do condomínio. O
          morador entra, escolhe, passa os produtos no totem e paga — a qualquer hora.
        </p>
        <p>
          A Just Go Market leva o conceito para o alto padrão: curadoria de empório, adega com trava, projeto desenhado
          para a arquitetura do prédio e uma operação discreta, toda nossa. O condomínio cede o espaço; nós cuidamos do
          resto.
        </p>
      </div>
    </div>
  </Section>

  <Section theme="ink" id="morador">
    <div class="container">
      <div class="section-head split">
        <div>
          <Eyebrow>Para o morador</Eyebrow>
          <SplitWords tag="h2" class="mt-m">Entre. Escolha. Siga.</SplitWords>
        </div>
        <p class="lead" data-reveal>Sem fila, sem caixa e sem aplicativo para comprar. Menos de dois minutos.</p>
      </div>
      <StickySteps steps={BUY_STEPS} />
    </div>
  </Section>

  <Section theme="dark" id="implantacao">
    <div class="container split">
      <div class="split-copy sticky-col">
        <Eyebrow>Implantação</Eyebrow>
        <SplitWords tag="h2">Quatro etapas. Nenhuma obra.</SplitWords>
        <p class="lead" data-reveal>
          Em média, {FACTS.totalDays} do primeiro contato à inauguração — o prazo depende sobretudo da agenda da
          assembleia.
        </p>
      </div>
      <ol class="timeline" data-scroll-progress>
        {
          ROLLOUT.map((step, i) => (
            <li data-reveal>
              <p class="timeline-meta">
                {String(i + 1).padStart(2, '0')} · {step.meta}
              </p>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <Section theme="paper" id="operacao">
    <div class="container">
      <div class="section-head split">
        <div>
          <Eyebrow>Operação diária</Eyebrow>
          <SplitWords tag="h2" class="mt-m">Depois da inauguração, o condomínio não faz nada.</SplitWords>
        </div>
        <p class="lead" data-reveal>Toda a rotina da loja é nossa — e invisível para a administração.</p>
      </div>
      <ul class="grid-3 op-grid">
        {
          OPERATION.map((o) => (
            <li class="card" data-reveal>
              <span class="card-icon">
                <Icon name={o.icon} draw />
              </span>
              <h3>{o.title}</h3>
              <p>{o.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="duo mt-l">
        <div class="card" data-reveal>
          <h3>A Just Go Market faz</h3>
          <ul class="list-check">
            {WE_DO.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="card" data-reveal>
          <h3>O condomínio fornece</h3>
          <ul class="list-check">
            {CONDO_GIVES.map((item) => <li>{item}</li>)}
          </ul>
          <p class="duo-note">Só isso.</p>
        </div>
      </div>
    </div>
  </Section>

  <Section theme="dark" id="tecnologia">
    <div class="container">
      <div class="section-head split">
        <div>
          <Eyebrow>Tecnologia</Eyebrow>
          <SplitWords tag="h2" class="mt-m">Tecnologia que não aparece.</SplitWords>
        </div>
        <p class="lead" data-reveal>
          O sistema trabalha nos bastidores para que a compra leve segundos e a reposição nunca atrase.
        </p>
      </div>
      <ul class="tech">
        {
          tech.map((t, i) => (
            <li data-reveal>
              <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <CtaFinal title="Quer ver funcionando de perto?" origin="como_funciona_cta" />
</BaseLayout>

<style>
  @layer components {
    @media (min-width: 1024px) {
      .split:has(.sticky-col) {
        align-items: start;
      }

      .sticky-col {
        position: sticky;
        top: calc(var(--header-h) + 48px);
      }
    }

    .op-grid .card p {
      margin-top: 4px;
    }

    .op-grid {
      gap: 16px;
    }

    @media (min-width: 1100px) {
      .op-grid {
        grid-template-columns: repeat(5, 1fr);
      }
    }

    .duo-note {
      margin-top: 24px;
      font-family: var(--font-title);
      font-size: 1.5rem;
      color: var(--fg);
    }

    .tech {
      display: grid;
      border-top: 1px solid var(--line);
    }

    .tech li {
      display: grid;
      gap: 8px;
      padding: 28px 0;
      border-bottom: 1px solid var(--line);
    }

    @media (min-width: 768px) {
      .tech li {
        grid-template-columns: 80px 1fr 1.4fr;
        align-items: baseline;
        gap: 24px;
      }
    }
  }
</style>

---
/**
 * Layout base — Just Go Market
 * - Ordem das camadas CSS declarada antes de qualquer folha de estilo.
 * - Classes no <html> decididas antes da primeira pintura:
 *     .js      → há JavaScript
 *     .motion  → há JS e o usuário não pediu "reduzir movimento"
 *     .intro-on / .intro-first → intro da home (só na 1ª visita da sessão)
 * - Transição entre páginas: View Transitions nativas entre documentos (CSS),
 *   sem roteador no cliente — o site continua estático, GTM/GA4 intactos.
 */
import SchemaOrg from '@components/SchemaOrg.astro';
import Analytics from '@components/Analytics.astro';
import AnalyticsNoscript from '@components/AnalyticsNoscript.astro';
import Fonts from '@components/site/Fonts.astro';
import Header from '@components/site/Header.astro';
import Footer from '@components/site/Footer.astro';
import Floating from '@components/site/Floating.astro';
import LeadDialog from '@components/site/LeadDialog.astro';
import Intro from '@components/site/Intro.astro';
import FloorIndicator from '@components/site/FloorIndicator.astro';
import { buildSEO, type SEOProps } from '@lib/seo';
import { organizationSchema, websiteSchema } from '@lib/schema';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

interface Props extends SEOProps {
  schemas?: Record<string, unknown>[];
  /** Intro do símbolo + portas (somente home). */
  intro?: boolean;
  /** Indicador de "andar" (somente home). */
  floors?: boolean;
  /** Oculta o painel de agendamento (ex.: na própria página de agendamento). */
  leadDialog?: boolean;
  /** Oculta a barra fixa de CTA no mobile. */
  stickyCta?: boolean;
  pageClass?: string;
}

const {
  schemas = [],
  intro = false,
  floors = false,
  leadDialog = true,
  stickyCta = true,
  pageClass = '',
  ...seoProps
} = Astro.props;

const seo = buildSEO(seoProps, Astro.url.pathname);
const allSchemas = [organizationSchema(), websiteSchema(), ...schemas];
---

<!doctype html>
<html lang="pt-BR" class:list={[pageClass]}>
  <head>
    <style is:inline>@layer reset, tokens, base, components, utilities;</style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <script is:inline define:vars={{ intro }}>
      (function (d, w) {
        var c = d.documentElement.classList;
        c.add('js');
        var reduce = w.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) c.add('motion');
        if (intro && !reduce) {
          try {
            if (!w.sessionStorage.getItem('jg-intro')) {
              w.sessionStorage.setItem('jg-intro', '1');
              c.add('intro-on', 'intro-first');
            }
          } catch (e) {}
        }
      })(document, window);
    </script>

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {
      seo.noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      )
    }

    <!-- OpenGraph -->
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={seo.ogType} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Just Go Market — O essencial, a um passo." />
    <meta property="og:site_name" content="Just Go Market" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.ogImage} />

    <meta name="theme-color" content="#010502" />
    <meta name="color-scheme" content="dark light" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/assets/images/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/images/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Fonts />
    <slot name="head" />

    <SchemaOrg schemas={allSchemas} />
    <Analytics />
  </head>

  <body>
    <AnalyticsNoscript />
    {intro && <Intro />}
    <Header />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Floating />
    {floors && <FloorIndicator />}
    {leadDialog && <LeadDialog />}
    {!stickyCta && <style is:inline>.m-cta{display:none!important}</style>}

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

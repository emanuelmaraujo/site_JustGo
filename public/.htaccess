# Página 404 personalizada (gerada pelo Astro)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    DirectoryIndex index.html

    # 1. Forçar HTTPS e remover WWW (Non-WWW)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.justgomarket\.com\.br$ [NC]
    RewriteRule ^(.*)$ https://justgomarket.com.br/$1 [L,R=301]

    # 1b. Redesign 2026 — páginas fundidas (301 permanentes, com ou sem .html e barra final)
    RewriteRule ^como-funciona-na-pratica(\.html)?/?$ https://justgomarket.com.br/como-funciona [R=301,L]
    RewriteRule ^zero-trabalho-sindico(\.html)?/?$ https://justgomarket.com.br/para-sindicos#zero-trabalho [R=301,L,NE]
    RewriteRule ^seguranca-do-mercado(\.html)?/?$ https://justgomarket.com.br/para-sindicos#seguranca [R=301,L,NE]
    RewriteRule ^quanto-custa(\.html)?/?$ https://justgomarket.com.br/para-sindicos#quanto-custa [R=301,L,NE]
    RewriteRule ^vantagens-para-moradores(\.html)?/?$ https://justgomarket.com.br/para-moradores [R=301,L]

    # Legado (antes do redesign)
    RewriteRule ^calculadora-roi/?$ https://justgomarket.com.br/diagnostico-condominio [R=301,L]
    RewriteRule ^cases/?$ https://justgomarket.com.br/como-funciona [R=301,L]

    # 2. Esconder o index.html principal e das subpastas
    RewriteCond %{THE_REQUEST} ^[A-Z]{3}\ /index\.html\ HTTP/ [NC]
    RewriteRule ^index\.html$ https://justgomarket.com.br/ [R=301,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3}\ /(.+)/index\.html\ HTTP/ [NC]
    RewriteRule ^(.+)/index\.html$ https://justgomarket.com.br/$1/ [R=301,L]

    # 3. Remover a barra final de URLs que não são diretórios para limpar a URL (ex: /sobre/ para /sobre)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ https://justgomarket.com.br/$1 [L,R=301]

    # 4. Esconder a extensão .html digitada diretamente na URL
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP [NC]
    RewriteRule ^(%1)\.html$ https://justgomarket.com.br/$1 [R=301,L]

    # 5. Mapear internamente as URLs limpas para seus respectivos arquivos .html gerados pelo Astro
    # Ignora arquivos reais e usa uma captura não gananciosa (.*?) para desconsiderar a barra final (/?$)
    # Isso resolve o conflito da pasta real /blog/ com o arquivo blog.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*?)/?$ $1.html [L]

</IfModule>
